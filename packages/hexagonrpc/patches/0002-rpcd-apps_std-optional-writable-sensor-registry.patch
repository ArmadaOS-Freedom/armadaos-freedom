+		ctx->registry_dirfd = open(getenv("HEXAGONRPCD_WRITABLE_REGISTRY"),
+					   O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+		if (ctx->registry_dirfd < 0)
+			fprintf(stderr, "Could not open writable registry %s: %s\n",
+					getenv("HEXAGONRPCD_WRITABLE_REGISTRY"),
+					strerror(errno));
+	}
+
 	iface->data = ctx;
 
 	return iface;
@@ -401,6 +666,14 @@ void fastrpc_apps_std_deinit(struct fastrpc_interface *iface)
 			hexagonfs_close(ctx->fds, i);
 	}
 
+	for (i = 0; i < APPS_STD_MAX_WFD; i++) {
+		if (ctx->wfds[i] >= 0)
+			close(ctx->wfds[i]);
+	}
+
+	if (ctx->registry_dirfd >= 0)
+		close(ctx->registry_dirfd);
+
 	free(iface->data);
 	free(iface);
 }
