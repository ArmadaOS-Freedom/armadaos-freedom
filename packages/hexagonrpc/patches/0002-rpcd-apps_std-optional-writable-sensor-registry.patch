 }
 
+static uint32_t apps_std_fwrite(void *data,
+				const struct fastrpc_io_buffer *inbufs,
+				struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const struct {
+		uint32_t fd;
+		uint32_t buf_size;
+	} *first_in = inbufs[0].p;
+	struct {
+		uint32_t written;
+		uint32_t is_eof;
+	} *first_out = outbufs[0].p;
+	const char *buf = inbufs[1].p;
+	size_t done = 0;
+	ssize_t ret;
+	int wfd;
+
+	if (!apps_std_is_wfd(first_in->fd))
+		return AEE_EBADPARM;
+
+	wfd = ctx->wfds[first_in->fd - APPS_STD_WFD_BASE];
+	if (wfd < 0 || first_in->buf_size > inbufs[1].s)
+		return AEE_EBADPARM;
+
+	while (done < first_in->buf_size) {
+		ret = write(wfd, buf + done, first_in->buf_size - done);
+		if (ret < 0) {
+			if (errno == EINTR)
+				continue;
+			fprintf(stderr, "Could not write file: %s\n", strerror(errno));
+			return AEE_EFAILED;
+		}
+		done += ret;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("write(%u, %u)\n", first_in->fd, first_in->buf_size);
+#endif
+
+	first_out->written = done;
+	first_out->is_eof = 0;
+
+	return 0;
+}
+
+/* A NUL-terminated registry path from inbuf i, relative to the registry directory, or NULL. */
+static const char *apps_std_registry_arg(const struct apps_std_ctx *ctx,
+					 const struct fastrpc_io_buffer *inbufs, int i)
+{
+	if (ctx->registry_dirfd < 0 || inbufs[i].s == 0
+	 || ((const char *) inbufs[i].p)[inbufs[i].s - 1] != 0)
+		return NULL;
+
+	return apps_std_registry_leaf(inbufs[i].p);
+}
+
+static uint32_t apps_std_fremove(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *rel = apps_std_registry_arg(ctx, inbufs, 1);
+
+	if (rel == NULL) {
+		fprintf(stderr, "Refused to remove %s\n",
+			inbufs[1].s ? (const char *) inbufs[1].p : "");
+		return AEE_EUNSUPPORTED;
+	}
+
+	if (unlinkat(ctx->registry_dirfd, rel, 0) && errno != ENOENT) {
+		fprintf(stderr, "Could not remove %s: %s\n", rel, strerror(errno));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("remove(%s)\n", rel);
+#endif
+
+	return 0;
+}
+
+static uint32_t apps_std_frename(void *data,
+				 const struct fastrpc_io_buffer *inbufs,
+				 struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const char *from = apps_std_registry_arg(ctx, inbufs, 1);
+	const char *to = apps_std_registry_arg(ctx, inbufs, 2);
+
+	if (from == NULL || to == NULL) {
+		fprintf(stderr, "Refused to rename %s to %s\n",
+			inbufs[1].s ? (const char *) inbufs[1].p : "",
+			inbufs[2].s ? (const char *) inbufs[2].p : "");
+		return AEE_EUNSUPPORTED;
+	}
+
+	if (renameat(ctx->registry_dirfd, from, ctx->registry_dirfd, to)) {
+		fprintf(stderr, "Could not rename %s to %s: %s\n",
+			from, to, strerror(errno));
+		return AEE_EFAILED;
+	}
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("rename(%s, %s)\n", from, to);
+#endif
+
+	return 0;
+}
+
+static uint32_t apps_std_fsync(void *data,
+			       const struct fastrpc_io_buffer *inbufs,
+			       struct fastrpc_io_buffer *outbufs)
+{
+	struct apps_std_ctx *ctx = data;
+	const uint32_t *fd = inbufs[0].p;
+
+	if (apps_std_is_wfd(*fd) && ctx->wfds[*fd - APPS_STD_WFD_BASE] >= 0
+	 && fsync(ctx->wfds[*fd - APPS_STD_WFD_BASE]))
+		return AEE_EFAILED;
+
+#ifdef HEXAGONRPC_VERBOSE
+	printf("fsync(%u)\n", *fd);
+#endif
+
+	return 0;
+}
+
 static uint32_t apps_std_fseek(void *data,
 			       const struct fastrpc_io_buffer *inbufs,
 			       struct fastrpc_io_buffer *outbufs)
@@ -167,9 +410,18 @@ static uint32_t apps_std_fopen_with_env(void *data,
 
 	rw_mode = ((const char *) inbufs[4].p)[0];
 	if (rw_mode == 'w' || rw_mode == 'a') {
-		fprintf(stderr, "Tried to open %s for writing\n",
-				(const char *) inbufs[3].p);
-		return AEE_EUNSUPPORTED;
