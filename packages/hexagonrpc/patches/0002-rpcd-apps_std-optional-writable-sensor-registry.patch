@@ -379,6 +631,19 @@ struct fastrpc_interface *fastrpc_apps_std_init(struct hexagonfs_dirent *root)
 						   ctx->rootfd,
 						   "/usr/lib/qcom/adsp/");
 
+	for (int i = 0; i < APPS_STD_MAX_WFD; i++)
