+/*
+ * Writable sensor registry.
+ *
+ * The sensor hub of newer platforms (SM8650 "lanai") writes its registry
+ * directory and stops loading sensors when that fails. When the environment
+ * variable HEXAGONRPCD_WRITABLE_REGISTRY names a host directory, files that
+ * the DSP opens for writing directly inside the persist registry directory are
+ * created there instead; everything else stays read-only. Point the variable at
+ * the same host directory that is mapped as the registry, so the DSP reads back
+ * what it wrote. Write handles use their own numbers, above the hexagonfs ones.
+ */
+#define APPS_STD_MAX_WFD	16
+#define APPS_STD_WFD_BASE	0x10000
+
+static const char *const apps_std_registry_prefixes[] = {
+	"/mnt/vendor/persist/sensors/registry/",
+	"/persist/sensors/registry/",
+};
+
+/* A plain file name: not empty, no slash, not "." or "..". */
+static bool apps_std_plain_name(const char *name, size_t len)
+{
+	if (len == 0 || memchr(name, '/', len) != NULL)
+		return false;
+
+	return !(len == 1 && name[0] == '.') && !(len == 2 && !strncmp(name, "..", 2));
+}
+
 struct apps_std_ctx {
 	int rootfd;
 	int adsp_avs_cfg_dirfd;
 	int adsp_library_dirfd;
 	struct hexagonfs_fd *fds[HEXAGONFS_MAX_FD];
+	int registry_dirfd;
+	int wfds[APPS_STD_MAX_WFD];
 };
 
+static bool apps_std_is_wfd(uint32_t fd)
+{
+	return fd >= APPS_STD_WFD_BASE
+	    && fd < APPS_STD_WFD_BASE + APPS_STD_MAX_WFD;
+}
+
+/*
+ * The path relative to the registry directory, or NULL when the path is
+ * anything else. Only "<name>" (the registry directory itself, which holds the
+ * version file, the parsed file list and temporary files) and "registry/<name>"
+ * (the registry entries) are accepted.
+ */
+static const char *apps_std_registry_leaf(const char *path)
+{
+	size_t i, n;
+	const char *rel, *slash;
+
+	for (i = 0; i < HRPC_ARRAY_SIZE(apps_std_registry_prefixes); i++) {
+		n = strlen(apps_std_registry_prefixes[i]);
+		if (strncmp(path, apps_std_registry_prefixes[i], n))
+			continue;
+
+		rel = path + n;
+		slash = strchr(rel, '/');
+		if (slash == NULL)
+			return apps_std_plain_name(rel, strlen(rel)) ? rel : NULL;
+
+		if ((size_t) (slash - rel) == strlen("registry")
+		 && !strncmp(rel, "registry", strlen("registry"))
+		 && apps_std_plain_name(slash + 1, strlen(slash + 1)))
+			return rel;
+
+		return NULL;
+	}
+
+	return NULL;
+}
+
+static int apps_std_open_write(struct apps_std_ctx *ctx, const char *path, char mode)
+{
+	const char *leaf;
+	int i, fd;
+
+	if (ctx->registry_dirfd < 0)
+		return -EROFS;
+
+	leaf = apps_std_registry_leaf(path);
+	if (leaf == NULL)
+		return -EACCES;
+
+	for (i = 0; i < APPS_STD_MAX_WFD; i++)
+		if (ctx->wfds[i] < 0)
+			break;
+
+	if (i == APPS_STD_MAX_WFD)
+		return -EMFILE;
+
+	fd = openat(ctx->registry_dirfd, leaf,
+		    O_WRONLY | O_CREAT | O_CLOEXEC | O_NOFOLLOW
+		    | (mode == 'a' ? O_APPEND : O_TRUNC),
+		    0600);
+	if (fd < 0)
+		return -errno;
+
+	ctx->wfds[i] = fd;
+
+	return APPS_STD_WFD_BASE + i;
+}
+
