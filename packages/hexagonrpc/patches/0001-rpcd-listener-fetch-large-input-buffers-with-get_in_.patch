From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "lich.wang" <lich.wang@gmail.com>
Date: Wed, 18 Nov 2026 16:30:46 +0800
Subject: [PATCH 1/3] rpcd: listener: fetch large input buffers with
 get_in_bufs2

next2 returns at most the first 256 bytes of a request's input buffers.
Requests with more input, such as apps_std writes of a sensor registry
entry, were dropped with "Large (>256B) input buffers aren't
implemented".

Fetch the remainder with adsp_listener method 5 (get_in_bufs2), which
reads it from an offset into the pending request. Requests above 64 MiB
are refused.
---
 hexagonrpcd/interface/adsp_listener.c | 16 ++++++++++
 hexagonrpcd/interface/adsp_listener.h | 12 +++++++
 hexagonrpcd/listener.c                | 45 +++++++++++++++++++++++----
 3 files changed, 67 insertions(+), 6 deletions(-)

diff --git a/hexagonrpcd/interface/adsp_listener.c b/hexagonrpcd/interface/adsp_listener.c
index d2197df..8adc1e9 100644
--- a/hexagonrpcd/interface/adsp_listener.c
+++ b/hexagonrpcd/interface/adsp_listener.c
@@ -48,3 +48,19 @@ const struct hrpc_method_def_interp4 adsp_listener_next2_def = {
 	.n_inner_types = 0,
 	.inner_types = NULL,
 };
+
+/* get_in_bufs2(ctx, offset, rout bufs, rout bufsLenReq): the rest of a large input */
+struct hrpc_arg_def_interp4 adsp_listener_get_in_bufs2_args[] = {
+	{ HRPC_ARG_WORD, sizeof(uint32_t) },
+	{ HRPC_ARG_WORD, sizeof(uint32_t) },
+	{ HRPC_ARG_OUT_BLOB, sizeof(uint32_t) },
+	{ HRPC_ARG_OUT_BLOB_SEQ, sizeof(char) },
+};
+
+const struct hrpc_method_def_interp4 adsp_listener_get_in_bufs2_def = {
+	.msg_id = 5,
+	.n_args = HRPC_ARRAY_SIZE(adsp_listener_get_in_bufs2_args),
+	.args = adsp_listener_get_in_bufs2_args,
+	.n_inner_types = 0,
+	.inner_types = NULL,
+};
diff --git a/hexagonrpcd/interface/adsp_listener.h b/hexagonrpcd/interface/adsp_listener.h
index 362d775..7da9eb5 100644
--- a/hexagonrpcd/interface/adsp_listener.h
+++ b/hexagonrpcd/interface/adsp_listener.h
@@ -51,4 +51,16 @@ static inline int adsp_listener_next2(int fd,
 			  inbufs_size, (void *) inbufs);
 }
 
+extern struct hrpc_method_def_interp4 adsp_listener_get_in_bufs2_def;
+static inline int adsp_listener_get_in_bufs2(int fd,
+					     uint32_t rctx,
+					     uint32_t offset,
+					     uint32_t *inbufs_len,
+					     uint32_t inbufs_size, char *inbufs)
+{
+	return hexagonrpc(&adsp_listener_get_in_bufs2_def, fd, ADSP_LISTENER,
+			  rctx, offset, inbufs_len,
+			  inbufs_size, (void *) inbufs);
+}
+
 #endif /* INTERFACE_ADSP_LISTENER_H */
diff --git a/hexagonrpcd/listener.c b/hexagonrpcd/listener.c
index 3414974..be5a15d 100644
--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -25,6 +25,8 @@
 #include <stddef.h>
 #include <stdint.h>
 #include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
 
 #include "interface/adsp_listener.h"
 #include "iobuffer.h"
@@ -425,9 +427,10 @@ static int return_for_next_invoke(int fd,
 				  struct fastrpc_io_buffer **decoded)
 {
 	struct fastrpc_decoder_context *ctx;
-	char inbufs[256];
+	char inbufs_small[256];
+	char *inbufs = inbufs_small, *large = NULL;
 	char *outbufs = NULL;
-	uint32_t inbufs_len;
+	uint32_t inbufs_len, rest_len;
 	uint32_t outbufs_len;
 	int ret;
 
@@ -457,10 +460,39 @@ static int return_for_next_invoke(int fd,
 		goto err_free_outbufs;
 	}
 
-	if (inbufs_len > 256) {
-		fprintf(stderr, "Large (>256B) input buffers aren't implemented\n");
-		ret = -1;
-		goto err_free_outbufs;
+	/*
+	 * The first 256 bytes came with next2; the DSP keeps the rest of a
+	 * large input for get_in_bufs2, which reads it from an offset.
+	 */
+	if (inbufs_len > sizeof(inbufs_small)) {
+		if (inbufs_len > 64 * 1024 * 1024) {
+			fprintf(stderr, "Input buffers too large: %u\n", inbufs_len);
+			ret = -1;
+			goto err_free_outbufs;
+		}
+
+		large = calloc(1, inbufs_len);
+		if (large == NULL) {
+			perror("Could not allocate large input buffer");
+			ret = -1;
+			goto err_free_outbufs;
+		}
+
+		memcpy(large, inbufs_small, sizeof(inbufs_small));
+		inbufs = large;
+
+		ret = adsp_listener_get_in_bufs2(fd, *rctx, sizeof(inbufs_small),
+						 &rest_len,
+						 inbufs_len - sizeof(inbufs_small),
+						 large + sizeof(inbufs_small));
+		if (ret) {
+			if (ret == -1)
+				perror("Could not fetch large input buffers");
+			else
+				fprintf(stderr, "Could not fetch large input buffers: %d\n", ret);
+
+			goto err_free_outbufs;
+		}
 	}
 
 	ctx = inbuf_decode_start(*sc);
@@ -486,6 +518,7 @@ static int return_for_next_invoke(int fd,
 
 err_free_outbufs:
 	free(outbufs);
+	free(large);
 	return ret;
 }
 
