From: 181981772 <181981772@qq.com>
Subject: [PATCH] ASoC: qcom: q6apm: serialize graph start and stop references

Keep the final start reference until GRAPH_STOP succeeds, allowing a real
retry after a command error. Serialize both graph start and stop around the
count decision and synchronous DSP command: a concurrent START must not see
the retained reference while STOP is in flight and skip its own command.

Use a mutex in the shared audioreach_graph, initialized before publication,
so different q6apm_graph wrappers share the same exclusion. A per-wrapper
buffer lock cannot protect the shared count. The lifecycle mutex nests
outside the existing APM command mutex; the response callback takes neither
lifecycle mutex. Local nested-reference decrements remain command-free.

This corrects reference accounting and command order. Final close after a
DSP timeout and graph/port callback lifetime remain separate work.

Signed-off-by: 181981772 <181981772@qq.com>
---
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -86,6 +86,8 @@
 	struct audioreach_graph_info *info;
 	uint32_t id;
 	int state;
+	/* Serialize graph START and STOP. */
+	struct mutex start_stop_lock;
 	int start_count;
 	/* Cached Graph data */
 	void *graph;
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -66,6 +66,7 @@
 	if (!graph)
 		return ERR_PTR(-ENOMEM);
 
+	mutex_init(&graph->start_stop_lock);
 	graph->apm = apm;
 	graph->info = info;
 	graph->id = graph_id;
@@ -830,31 +831,49 @@
 int q6apm_graph_start(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
-	int ret;
+	int ret = 0;
+
+	mutex_lock(&ar_graph->start_stop_lock);
 
 	if (ar_graph->start_count == 0) {
 		ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_START);
 		if (ret)
-			return ret;
+			goto unlock;
 	}
 
 	ar_graph->start_count++;
 
-	return 0;
+unlock:
+	mutex_unlock(&ar_graph->start_stop_lock);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_start);
 
 int q6apm_graph_stop(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
-
-	if (ar_graph->start_count == 0)
-		return 0;
-
-	if (--ar_graph->start_count > 0)
-		return 0;
-
-	return audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
+	int ret;
+
+	mutex_lock(&ar_graph->start_stop_lock);
+
+	if (ar_graph->start_count == 0) {
+		ret = 0;
+		goto unlock;
+	}
+
+	if (ar_graph->start_count > 1) {
+		ar_graph->start_count--;
+		ret = 0;
+		goto unlock;
+	}
+
+	ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
+	if (!ret)
+		ar_graph->start_count--;
+
+unlock:
+	mutex_unlock(&ar_graph->start_stop_lock);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_stop);
 
