From: 181981772 <181981772@qq.com>
Subject: [PATCH] ASoC: qcom: q6apm: stop capture before backend shutdown

Capture prepare starts the frontend graph before a capture START trigger.
On prepare followed by close, ASoC can shut down the backend while the
frontend is still running, because the existing frontend stop is in close.

Stop the capture frontend in component hw_free, before backend shutdown.
Serialize capture read requeue against the STOPPED transition. Release the
mutex before waiting for DSP STOP. Keep fragment cleanup in close/reprepare
and distinguish successful graph STOP from the software trigger state to
avoid duplicate reference releases. Return a reprepare STOP error before
freeing/restarting the previous setup.

Playback and compressed stream sequencing are unchanged. Existing final
close cleanup after a DSP error and callback lifetime after port teardown
remain outside this ordering fix.

Signed-off-by: 181981772 <181981772@qq.com>
---
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -81,6 +81,8 @@
 	struct q6apm_graph *graph;
 	spinlock_t lock;
 	bool notify_on_drain;
+	bool graph_stopped;
+	struct mutex capture_lock;	/* serializes capture read and STOP */
 };
 
 struct q6apm_dai_data {
@@ -137,7 +139,7 @@
 		snd_pcm_period_elapsed(substream);
 		break;
 	case APM_CLIENT_EVENT_CMD_EOS_DONE:
-		prtd->state = Q6APM_STREAM_STOPPED;
+		WRITE_ONCE(prtd->state, Q6APM_STREAM_STOPPED);
 		break;
 	case APM_CLIENT_EVENT_DATA_WRITE_DONE:
 		snd_pcm_period_elapsed(substream);
@@ -145,8 +147,10 @@
 		break;
 	case APM_CLIENT_EVENT_DATA_READ_DONE:
 		snd_pcm_period_elapsed(substream);
-		if (prtd->state == Q6APM_STREAM_RUNNING)
+		mutex_lock(&prtd->capture_lock);
+		if (READ_ONCE(prtd->state) == Q6APM_STREAM_RUNNING)
 			q6apm_read(prtd->graph);
+		mutex_unlock(&prtd->capture_lock);
 
 		break;
 	default:
@@ -211,19 +215,80 @@
 	}
 }
 
+static int q6apm_dai_stop_capture(struct q6apm_dai_rtd *prtd)
+{
+	int ret;
+
+	mutex_lock(&prtd->capture_lock);
+	if (READ_ONCE(prtd->state) == Q6APM_STREAM_IDLE ||
+	    prtd->graph_stopped) {
+		mutex_unlock(&prtd->capture_lock);
+		return 0;
+	}
+
+	WRITE_ONCE(prtd->state, Q6APM_STREAM_STOPPED);
+	mutex_unlock(&prtd->capture_lock);
+
+	ret = q6apm_graph_stop(prtd->graph);
+	if (ret)
+		return ret;
+
+	mutex_lock(&prtd->capture_lock);
+	prtd->graph_stopped = true;
+	mutex_unlock(&prtd->capture_lock);
+	return 0;
+}
+
 static void q6apm_dai_release_graph(struct q6apm_dai_rtd *prtd, int stream)
 {
-	if (prtd->state)
+	int ret;
+
+	if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		ret = q6apm_dai_stop_capture(prtd);
+		if (ret)
+			dev_err(prtd->graph->dev,
+				"Failed to stop capture graph %d\n", ret);
+	} else if (READ_ONCE(prtd->state)) {
 		q6apm_graph_stop(prtd->graph);
+	}
 	q6apm_free_fragments(prtd->graph, stream);
 	q6apm_graph_close(prtd->graph);
 	prtd->graph = NULL;
-	prtd->state = Q6APM_STREAM_IDLE;
+	prtd->graph_stopped = false;
+	WRITE_ONCE(prtd->state, Q6APM_STREAM_IDLE);
 	prtd->queue_ptr = 0;
 	prtd->last_pos_index = 0;
 	prtd->push_pull_size = 0;
 }
 
+static int q6apm_dai_hw_free(struct snd_soc_component *component,
+			     struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct q6apm_dai_rtd *prtd;
+	int ret;
+
+	/*
+	 * Capture prepare starts the FE before the BE trigger.  Stop the FE
+	 * while ASoC hw_free is still ahead of BE shutdown.  Keep the fragments
+	 * until close or the next prepare, matching their existing lifetime.
+	 */
+	if (substream->stream != SNDRV_PCM_STREAM_CAPTURE || !runtime)
+		return 0;
+
+	prtd = runtime->private_data;
+	if (!prtd || !prtd->graph)
+		return 0;
+
+	ret = q6apm_dai_stop_capture(prtd);
+	if (ret) {
+		dev_err(component->dev, "Failed to stop capture graph %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
 static int q6apm_dai_prepare(struct snd_soc_component *component,
 			     struct snd_pcm_substream *substream)
 {
@@ -249,11 +314,23 @@
 	cfg.bit_width = prtd->bits_per_sample;
 	cfg.fmt = SND_AUDIOCODEC_PCM;
 	audioreach_set_default_channel_mapping(cfg.channel_map, runtime->channels);
-	if (prtd->state) {
-		/* clear the previous setup if any  */
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		ret = q6apm_dai_stop_capture(prtd);
+		if (ret) {
+			dev_err(dev, "Failed to stop previous capture graph %d\n", ret);
+			return ret;
+		}
+		if (READ_ONCE(prtd->state) != Q6APM_STREAM_IDLE) {
+			/* clear the previous setup if any */
+			q6apm_free_fragments(prtd->graph, substream->stream);
+			prtd->graph_stopped = false;
+			WRITE_ONCE(prtd->state, Q6APM_STREAM_IDLE);
+		}
+	} else if (prtd->state) {
+		/* clear the previous setup if any */
 		q6apm_graph_stop(prtd->graph);
 		q6apm_free_fragments(prtd->graph, substream->stream);
-		prtd->state = Q6APM_STREAM_IDLE;
+		WRITE_ONCE(prtd->state, Q6APM_STREAM_IDLE);
 	}
 
 	prtd->queue_ptr = 0;
@@ -311,6 +388,7 @@
 		dev_err(dev, "Failed to Start Graph %d\n", ret);
 		return ret;
 	}
+	prtd->graph_stopped = false;
 	if (!q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
 		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
 			int i;
@@ -321,7 +399,7 @@
 	}
 
 	/* Now that graph as been prepared and started update the internal state accordingly */
-	prtd->state = Q6APM_STREAM_RUNNING;
+	WRITE_ONCE(prtd->state, Q6APM_STREAM_RUNNING);
 
 	return 0;
 }
@@ -333,7 +411,8 @@
 	int i, ret = 0, avail_periods;
 
 	/* SYNC_PTR can get here before prepare has allocated fragments */
-	if (!prtd->graph || prtd->state == Q6APM_STREAM_IDLE)
+	if (!prtd->graph ||
+	    READ_ONCE(prtd->state) == Q6APM_STREAM_IDLE)
 		return 0;
 
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph))
@@ -368,7 +447,7 @@
 		break;
 	case SNDRV_PCM_TRIGGER_STOP:
 		/* TODO support be handled via SoftPause Module */
-		prtd->state = Q6APM_STREAM_STOPPED;
+		WRITE_ONCE(prtd->state, Q6APM_STREAM_STOPPED);
 		prtd->queue_ptr = 0;
 		prtd->last_pos_index = 0;
 		break;
@@ -407,6 +486,7 @@
 		return -ENOMEM;
 
 	spin_lock_init(&prtd->lock);
+	mutex_init(&prtd->capture_lock);
 	prtd->substream = substream;
 	prtd->graph = q6apm_graph_open(dev, event_handler, prtd, graph_id, substream->stream);
 	if (IS_ERR(prtd->graph)) {
@@ -1091,6 +1171,7 @@
 	.pcm_new	= q6apm_dai_pcm_new,
 	.pcm_free	= q6apm_dai_pcm_free,
 	.hw_params	= q6apm_dai_hw_params,
+	.hw_free	= q6apm_dai_hw_free,
 	.pointer	= q6apm_dai_pointer,
 	.trigger	= q6apm_dai_trigger,
 	.ack		= q6apm_dai_ack,
