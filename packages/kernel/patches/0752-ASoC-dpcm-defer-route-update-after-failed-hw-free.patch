 				goto next;
 
+			dpcm->stop_snapshot.state = be->dpcm[stream].state;
+			dpcm->stop_snapshot.be_start =
+				be->dpcm[stream].be_start;
+			dpcm->stop_snapshot.be_pause =
+				be->dpcm[stream].be_pause;
+			dpcm->stop_snapshot.active = true;
