+/*
+ * A path-add operation can allocate a new DPCM link or revive an existing
+ * retained link.  Keep that distinction visible to the caller so a later
+ * connection failure can undo exactly the links changed by this operation.
+ */
+enum dpcm_path_change_type {
+	DPCM_PATH_UNCHANGED,
+	DPCM_PATH_NEW,
+	DPCM_PATH_REUSED,
+};
+
+struct dpcm_path_change {
+	struct snd_soc_dpcm *dpcm;
+	enum dpcm_path_change_type type;
+	enum snd_soc_dpcm_update update;
+	enum snd_soc_dpcm_state state;
+	int be_start;
+	int be_pause;
+	bool hardware_started;
+};
+
+static bool dpcm_route_stop_done(struct snd_soc_dpcm *dpcm, int stream)
+{
+	struct snd_pcm_substream *be_substream;
+	unsigned long flags;
+	bool done;
+
+	be_substream = snd_soc_dpcm_get_substream(dpcm->be, stream);
+	/*
+	 * A retained link without a BE substream cannot issue another STOP.
+	 * Treat it as converged so it can neither be reused nor left active.
+	 */
+	if (!be_substream)
+		return true;
+
+	snd_pcm_stream_lock_irqsave_nested(be_substream, flags);
+	done = READ_ONCE(dpcm->route_stop_done);
+	snd_pcm_stream_unlock_irqrestore(be_substream, flags);
+
+	return done;
+}
