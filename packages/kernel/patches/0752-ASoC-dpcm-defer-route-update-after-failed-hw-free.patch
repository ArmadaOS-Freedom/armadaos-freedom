+			dpcm_be_dai_stop_rollback(fe, stream, dpcm, fe_pause);
+		else
+			dpcm_be_dai_stop_commit(fe, stream);
+	}
+
 	return soc_pcm_ret(fe, ret);
 }
 EXPORT_SYMBOL_GPL(dpcm_be_dai_trigger);
