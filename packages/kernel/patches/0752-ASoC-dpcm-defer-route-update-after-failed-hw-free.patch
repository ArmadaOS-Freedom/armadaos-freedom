+/* Caller holds the BE stream lock. */
+static int dpcm_be_dai_stop_restore(struct snd_soc_pcm_runtime *be,
+				    int stream,
+				    const struct snd_soc_dpcm_stop_snapshot *snapshot)
+{
+	struct snd_pcm_substream *be_substream;
+	int ret = 0;
+
+	if (be->dpcm[stream].state == snapshot->state)
+		goto restore;
+
+	be_substream = snd_soc_dpcm_get_substream(be, stream);
+	switch (snapshot->state) {
+	case SND_SOC_DPCM_STATE_START:
+		if (be->dpcm[stream].state == SND_SOC_DPCM_STATE_PAUSED)
+			ret = soc_pcm_trigger(be_substream,
+					      SNDRV_PCM_TRIGGER_PAUSE_RELEASE);
+		else if (be->dpcm[stream].state == SND_SOC_DPCM_STATE_STOP)
+			ret = soc_pcm_trigger(be_substream,
+					      SNDRV_PCM_TRIGGER_START);
+		else
+			return -EIO;
+		break;
+	case SND_SOC_DPCM_STATE_PAUSED:
+		if (be->dpcm[stream].state == SND_SOC_DPCM_STATE_START) {
+			ret = soc_pcm_trigger(be_substream,
+					      SNDRV_PCM_TRIGGER_PAUSE_PUSH);
+		} else if (be->dpcm[stream].state == SND_SOC_DPCM_STATE_STOP) {
+			ret = soc_pcm_trigger(be_substream,
+					      SNDRV_PCM_TRIGGER_START);
+			if (ret)
+				return ret;
+
+			be->dpcm[stream].state = SND_SOC_DPCM_STATE_START;
+			be->dpcm[stream].be_start = 1;
+			ret = soc_pcm_trigger(be_substream,
+					      SNDRV_PCM_TRIGGER_PAUSE_PUSH);
+		} else {
+			return -EIO;
+		}
+		break;
+	default:
+		return -EIO;
+	}
+
+	if (ret)
+		return ret;
+
+restore:
+	be->dpcm[stream].state = snapshot->state;
+	be->dpcm[stream].be_start = snapshot->be_start;
+	be->dpcm[stream].be_pause = snapshot->be_pause;
+	return 0;
+}
+
+/*
+ * A partially successful STOP transaction must restore the exact BE state
+ * from before the attempt, including paused reference counts.
+ */
+static void dpcm_be_dai_stop_rollback(struct snd_soc_pcm_runtime *fe,
+				      int stream,
+				      struct snd_soc_dpcm *last,
+				      bool fe_pause)
+{
+	struct snd_soc_dpcm *dpcm;
+	unsigned long flags;
+	int ret;
+
+	for_each_dpcm_be(fe, stream, dpcm) {
+		struct snd_pcm_substream *be_substream;
+		struct snd_soc_pcm_runtime *be;
+
+		if (dpcm == last)
+			break;
+
+		be = dpcm->be;
+		be_substream = snd_soc_dpcm_get_substream(be, stream);
+		snd_pcm_stream_lock_irqsave_nested(be_substream, flags);
+		if (!dpcm->stop_snapshot.active)
+			goto unlock;
+		ret = dpcm_be_dai_stop_restore(be, stream,
+					       &dpcm->stop_snapshot);
+		if (ret)
+			dev_err(be->dev,
+				"failed to restore BE %s after STOP rollback (%d)\n",
+				be->dai_link->name, ret);
+		dpcm->stop_snapshot.active = false;
+unlock:
+		snd_pcm_stream_unlock_irqrestore(be_substream, flags);
+	}
+
+	fe->dpcm[stream].fe_pause = fe_pause;
+}
+
+static void dpcm_be_dai_stop_commit(struct snd_soc_pcm_runtime *fe, int stream)
+{
+	struct snd_soc_dpcm *dpcm;
+	unsigned long flags;
+
+	for_each_dpcm_be(fe, stream, dpcm) {
+		struct snd_pcm_substream *be_substream;
+
+		be_substream = snd_soc_dpcm_get_substream(dpcm->be, stream);
+		snd_pcm_stream_lock_irqsave_nested(be_substream, flags);
+		dpcm->stop_snapshot.active = false;
+		snd_pcm_stream_unlock_irqrestore(be_substream, flags);
+	}
+}
