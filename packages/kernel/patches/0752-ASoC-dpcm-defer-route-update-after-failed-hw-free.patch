 }
 EXPORT_SYMBOL_GPL(snd_soc_dpcm_runtime_update);
 
+static void snd_soc_dpcm_retry_pending_route_update(struct snd_soc_card *card)
+{
+	int ret;
+
+	snd_soc_dpcm_mutex_assert_held(card);
+	if (!READ_ONCE(card->dpcm_route_update_pending))
+		return;
+
+	ret = snd_soc_dpcm_runtime_update_locked(card);
+	if (ret && ret != -EBUSY)
+		dev_err(card->dev, "deferred DPCM route update failed (%d)\n", ret);
+}
