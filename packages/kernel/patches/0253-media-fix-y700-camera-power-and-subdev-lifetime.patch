Subject: [PATCH] media: fix Y700 camera power and sub-device lifetime

Keep opt-in V4L2 device nodes and controls alive through the final close,
serialize node I/O with unregister, and remove the media interface and
its links under the graph mutex. Balance lens and sensor PM references
on detach. Reapply reset sequencing if a stream retry needs it.

Report retained supplies or a failed reset as a retryable suspend error.
Bound delayed runtime suspend requests and drain them on detach. Treat
post-release supply errors as fatal for I/O while still allowing the
other retained votes to be released. Make system sleep attempt cleanup
even when an earlier failed runtime resume left resources behind.

diff --git a/drivers/media/i2c/Kconfig b/drivers/media/i2c/Kconfig
index d1e1eb9..3df5a84 100755
--- a/drivers/media/i2c/Kconfig
+++ b/drivers/media/i2c/Kconfig
@@ -92,7 +92,7 @@ config VIDEO_GC05A2
 
 config VIDEO_GC08A8
 	tristate "GalaxyCore GC08A8 sensor support"
-	depends on I2C && VIDEO_DEV
+	depends on I2C && VIDEO_DEV && PM
 	select V4L2_CCI_I2C
 	select V4L2_FWNODE
 	help
@@ -807,7 +807,7 @@ config VIDEO_S5K6A3
 
 config VIDEO_S5KJNS
 	tristate "Samsung S5KJNS sensor support"
-	depends on I2C && VIDEO_DEV
+	depends on I2C && VIDEO_DEV && PM
 	select V4L2_CCI_I2C
 	select V4L2_FWNODE
 	help
diff --git a/drivers/media/i2c/gc08a8.c b/drivers/media/i2c/gc08a8.c
index 87a651b..eb8954d 100755
--- a/drivers/media/i2c/gc08a8.c
+++ b/drivers/media/i2c/gc08a8.c
@@ -5,9 +5,12 @@
 #include <linux/delay.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
+#include <linux/kref.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
 
 #include <media/v4l2-cci.h>
 #include <media/v4l2-ctrls.h>
@@ -26,6 +29,7 @@ static const s64 gc08a8_link_freq[] = { 336000000 };
 static const char * const gc08a8_supply_names[] = { "dovdd", "dvdd", "avdd" };
 
 struct gc08a8 {
+	struct kref ref;
 	struct v4l2_subdev sd;
 	struct media_pad pad;
 	struct v4l2_ctrl_handler ctrls;
@@ -33,11 +37,16 @@ struct gc08a8 {
 	struct clk *xclk;
 	struct gpio_desc *reset;
 	struct regulator_bulk_data supplies[ARRAY_SIZE(gc08a8_supply_names)];
-	/* Only references whose ownership is still known are tracked here. */
+	struct delayed_work power_off_work;
 	unsigned long supplies_enabled;
+	unsigned int power_off_retries;
 	bool clock_enabled;
+	bool reset_asserted;
+	int reset_error;
+	int supply_error;
 	int power_error;
 	bool streaming;
+	bool detached;
 };
 
 static struct gc08a8 *to_gc08a8(struct v4l2_subdev *sd)
@@ -45,6 +54,33 @@ static struct gc08a8 *to_gc08a8(struct v4l2_subdev *sd)
 	return container_of(sd, struct gc08a8, sd);
 }
 
+static void gc08a8_free(struct kref *ref)
+{
+	struct gc08a8 *sensor = container_of(ref, struct gc08a8, ref);
+
+	v4l2_subdev_cleanup(&sensor->sd);
+	media_entity_cleanup(&sensor->sd.entity);
+	v4l2_ctrl_handler_free(&sensor->ctrls);
+	kfree(sensor);
+}
+
+static void gc08a8_put(void *data)
+{
+	struct gc08a8 *sensor = data;
+
+	kref_put(&sensor->ref, gc08a8_free);
+}
+
+static void gc08a8_devnode_get(struct v4l2_subdev *sd)
+{
+	kref_get(&to_gc08a8(sd)->ref);
+}
+
+static void gc08a8_devnode_put(struct v4l2_subdev *sd)
+{
+	gc08a8_put(to_gc08a8(sd));
+}
+
 static const struct cci_reg_sequence gc08a8_init_regs[] = {
 	{ CCI_REG8(0x031c), 0x60 },
 	{ CCI_REG8(0x0337), 0x03 },
@@ -489,57 +525,106 @@ static const struct cci_reg_sequence gc08a8_3264x2448_regs[] = {
 	{ CCI_REG8(0x0102), 0x09 },
 };
 
-static void gc08a8_assert_reset(struct gc08a8 *sensor)
+static int gc08a8_set_reset(struct gc08a8 *sensor, bool asserted)
 {
 	int ret;
 
-	ret = gpiod_set_value_cansleep(sensor->reset, 1);
-	if (ret) {
-		if (!sensor->power_error)
-			sensor->power_error = ret;
-		dev_err(sensor->sd.dev, "Failed to assert reset: %d; reboot required\n", ret);
+	ret = gpiod_set_value_cansleep(sensor->reset, asserted);
+	sensor->reset_error = ret;
+	if (ret)
+		dev_err(sensor->sd.dev, "Failed to %s reset: %d\n",
+			asserted ? "assert" : "release", ret);
+	else
+		sensor->reset_asserted = asserted;
+	return ret;
+}
+
+static int gc08a8_restore_reset(struct gc08a8 *sensor)
+{
+	int ret;
+
+	if (sensor->reset_error) {
+		ret = gc08a8_set_reset(sensor, true);
+		if (ret)
+			return ret;
 	}
+	if (!sensor->reset_asserted)
+		return 0;
+
+	fsleep(3000);
+	ret = gc08a8_set_reset(sensor, false);
+	if (!ret)
+		fsleep(3000);
+	return ret;
 }
 
 static int gc08a8_disable_supplies(struct gc08a8 *sensor)
 {
 	struct device *dev = sensor->sd.dev;
-	int i, ret;
+	int index, ret, error = sensor->supply_error;
+	bool released;
 
-	for (i = ARRAY_SIZE(sensor->supplies) - 1; i >= 0; i--) {
-		if (!(sensor->supplies_enabled & BIT(i)))
+	for (index = ARRAY_SIZE(sensor->supplies) - 1; index >= 0; index--) {
+		if (!(sensor->supplies_enabled & BIT(index)))
 			continue;
-		/*
-		 * A disable error can occur after the consumer reference was
-		 * dropped (for example, while disabling a parent supply).
-		 * Its ownership is then unknown: never retry or re-enable it.
-		 */
-		sensor->supplies_enabled &= ~BIT(i);
-		ret = regulator_disable(sensor->supplies[i].consumer);
+		ret = regulator_disable_with_status(sensor->supplies[index].consumer,
+						    &released);
+		if (released)
+			sensor->supplies_enabled &= ~BIT(index);
 		if (ret) {
-			if (!sensor->power_error)
-				sensor->power_error = ret;
-			dev_err(dev, "Failed to disable %s: %d; reboot required\n",
-				sensor->supplies[i].supply, ret);
+			if (released && !sensor->supply_error)
+				sensor->supply_error = ret;
+			if (!error)
+				error = ret;
+			dev_err(dev, "Failed to disable %s: %d (reference %s)\n",
+				sensor->supplies[index].supply, ret,
+				released ? "released" : "retained");
 		}
 		fsleep(1000);
 	}
 
-	return sensor->power_error;
+	return error;
 }
 
 static int gc08a8_power_off(struct device *dev)
 {
 	struct gc08a8 *sensor = to_gc08a8(dev_get_drvdata(dev));
+	int reset_ret, ret;
 
-	gc08a8_assert_reset(sensor);
+	reset_ret = gc08a8_set_reset(sensor, true);
 	fsleep(3000);
 	if (sensor->clock_enabled) {
 		clk_disable_unprepare(sensor->xclk);
 		sensor->clock_enabled = false;
 		fsleep(10000);
 	}
-	return gc08a8_disable_supplies(sensor);
+	ret = gc08a8_disable_supplies(sensor);
+	WRITE_ONCE(sensor->power_error, reset_ret ?: ret);
+	return reset_ret ?: ret;
+}
+
+static void gc08a8_retry_power_off(struct work_struct *work)
+{
+	struct gc08a8 *sensor = container_of(to_delayed_work(work), struct gc08a8,
+					    power_off_work);
+
+	pm_runtime_suspend(sensor->sd.dev);
+}
+
+static int gc08a8_runtime_suspend(struct device *dev)
+{
+	struct gc08a8 *sensor = to_gc08a8(dev_get_drvdata(dev));
+	int ret = gc08a8_power_off(dev);
+
+	if (sensor->supplies_enabled || sensor->reset_error) {
+		if (sensor->power_off_retries &&
+		    queue_delayed_work(system_freezable_wq, &sensor->power_off_work,
+				       msecs_to_jiffies(100)))
+			sensor->power_off_retries--;
+		return -EAGAIN;
+	}
+	cancel_delayed_work(&sensor->power_off_work);
+	return ret ? -EIO : 0;
 }
 
 static int gc08a8_power_on(struct device *dev)
@@ -547,11 +632,16 @@ static int gc08a8_power_on(struct device *dev)
 	struct gc08a8 *sensor = to_gc08a8(dev_get_drvdata(dev));
 	int i, ret;
 
-	if (sensor->power_error)
-		return sensor->power_error;
-	ret = gpiod_set_value_cansleep(sensor->reset, 1);
+	if (sensor->power_error) {
+		if (sensor->supply_error)
+			return sensor->power_error;
+		ret = gc08a8_power_off(dev);
+		if (ret)
+			return ret;
+	}
+	ret = gc08a8_set_reset(sensor, true);
 	if (ret)
-		return ret;
+		goto power_off;
 	fsleep(1000);
 	for (i = 0; i < ARRAY_SIZE(sensor->supplies); i++) {
 		ret = regulator_enable(sensor->supplies[i].consumer);
@@ -566,7 +656,7 @@ static int gc08a8_power_on(struct device *dev)
 		goto power_off;
 	sensor->clock_enabled = true;
 	fsleep(10000);
-	ret = gpiod_set_value_cansleep(sensor->reset, 0);
+	ret = gc08a8_set_reset(sensor, false);
 	if (ret)
 		goto power_off;
 	fsleep(3000);
@@ -578,6 +668,23 @@ power_off:
 	return ret;
 }
 
+static int gc08a8_runtime_resume(struct device *dev)
+{
+	struct gc08a8 *sensor = to_gc08a8(dev_get_drvdata(dev));
+	int ret = gc08a8_power_on(dev);
+
+	if (!ret) {
+		sensor->power_off_retries = 3;
+		return 0;
+	}
+	dev_err_ratelimited(dev, "Power-up failed: %d\n", ret);
+	if (sensor->supply_error)
+		return -EIO;
+	if (ret == -ENOTRECOVERABLE && !sensor->power_error)
+		return ret;
+	return -EAGAIN;
+}
+
 static int gc08a8_set_ctrl(struct v4l2_ctrl *ctrl)
 {
 	struct gc08a8 *sensor = container_of(ctrl->handler, struct gc08a8, ctrls);
@@ -585,6 +692,9 @@ static int gc08a8_set_ctrl(struct v4l2_ctrl *ctrl)
 	u16 reg;
 	int ret = 0, release;
 
+	if (sensor->detached)
+		return -ENODEV;
+
 	switch (ctrl->id) {
 	case V4L2_CID_EXPOSURE:
 		reg = 0x0202;
@@ -596,12 +706,14 @@ static int gc08a8_set_ctrl(struct v4l2_ctrl *ctrl)
 		return 0;
 	}
 
-	if (sensor->power_error)
-		return sensor->power_error;
 	ret = pm_runtime_get_if_in_use(dev);
 	if (ret <= 0)
 		return ret;
-	ret = 0;
+	ret = sensor->power_error;
+	if (ret || sensor->reset_asserted || sensor->reset_error) {
+		pm_runtime_put(dev);
+		return ret;
+	}
 
 	cci_write(sensor->regmap, CCI_REG8(0x0104), 1, &ret);
 	cci_write(sensor->regmap, CCI_REG8(reg), ctrl->val >> 8, &ret);
@@ -648,11 +760,8 @@ static int gc08a8_init_controls(struct gc08a8 *sensor)
 	v4l2_ctrl_new_std(hdl, &gc08a8_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
 			  1024, 16384, 1, 1024);
 	v4l2_ctrl_new_fwnode_properties(hdl, &gc08a8_ctrl_ops, &props);
-	if (hdl->error) {
-		ret = hdl->error;
-		v4l2_ctrl_handler_free(hdl);
-		return ret;
-	}
+	if (hdl->error)
+		return hdl->error;
 	sensor->sd.ctrl_handler = hdl;
 	return 0;
 }
@@ -741,20 +850,18 @@ static int gc08a8_s_stream(struct v4l2_subdev *sd, int enable)
 	int ret = 0, power_ret;
 
 	state = v4l2_subdev_lock_and_get_active_state(sd);
-	if (enable && sensor->power_error) {
-		ret = sensor->power_error;
+	if (sensor->detached) {
+		ret = -ENODEV;
 		goto unlock;
 	}
-	if (sensor->streaming == !!enable) {
-		ret = sensor->power_error;
+	if (sensor->streaming == !!enable)
 		goto unlock;
-	}
 	if (!enable) {
 		ret = cci_write(sensor->regmap, CCI_REG8(0x0100), 0, NULL);
 		sensor->streaming = false;
 		/* Release this stream's PM reference even if either step fails. */
 		if (ret)
-			gc08a8_assert_reset(sensor);
+			gc08a8_set_reset(sensor, true);
 		power_ret = pm_runtime_put_sync(sd->dev);
 		if (power_ret < 0) {
 			dev_err(sd->dev, "Failed to power off after stream stop: %d\n",
@@ -768,6 +875,12 @@ static int gc08a8_s_stream(struct v4l2_subdev *sd, int enable)
 	ret = pm_runtime_resume_and_get(sd->dev);
 	if (ret < 0)
 		goto unlock;
+	ret = sensor->power_error;
+	if (ret)
+		goto put_pm;
+	ret = gc08a8_restore_reset(sensor);
+	if (ret)
+		goto put_pm;
 	cci_multi_reg_write(sensor->regmap, gc08a8_init_regs,
 			    ARRAY_SIZE(gc08a8_init_regs), &ret);
 	cci_multi_reg_write(sensor->regmap, gc08a8_3264x2448_regs,
@@ -776,14 +889,17 @@ static int gc08a8_s_stream(struct v4l2_subdev *sd, int enable)
 		ret = __v4l2_ctrl_handler_setup(&sensor->ctrls);
 	cci_write(sensor->regmap, CCI_REG8(0x0100), 1, &ret);
 	if (ret) {
-		gc08a8_assert_reset(sensor);
-		power_ret = pm_runtime_put_sync(sd->dev);
-		if (power_ret < 0)
-			dev_err(sd->dev, "Failed to power off after stream-start error: %d\n",
-				power_ret);
-	} else {
-		sensor->streaming = true;
+		gc08a8_set_reset(sensor, true);
+		goto put_pm;
 	}
+	sensor->streaming = true;
+	goto unlock;
+
+put_pm:
+	power_ret = pm_runtime_put_sync(sd->dev);
+	if (power_ret < 0)
+		dev_err(sd->dev, "Failed to power off after stream-start error: %d\n",
+			power_ret);
 unlock:
 	v4l2_subdev_unlock_state(state);
 	return ret;
@@ -808,6 +924,8 @@ static const struct v4l2_subdev_ops gc08a8_ops = {
 
 static const struct v4l2_subdev_internal_ops gc08a8_internal_ops = {
 	.init_state = gc08a8_init_state,
+	.devnode_get = gc08a8_devnode_get,
+	.devnode_put = gc08a8_devnode_put,
 };
 
 static int gc08a8_check_endpoint(struct device *dev)
@@ -838,6 +956,27 @@ free:
 	return ret;
 }
 
+static void gc08a8_stop_pm(struct gc08a8 *sensor)
+{
+	struct device *dev = sensor->sd.dev;
+	int ret;
+
+	mutex_lock(sensor->ctrls.lock);
+	sensor->detached = true;
+	pm_runtime_disable(dev);
+	disable_delayed_work_sync(&sensor->power_off_work);
+	if (sensor->streaming) {
+		pm_runtime_put_noidle(dev);
+		sensor->streaming = false;
+	}
+	ret = gc08a8_power_off(dev);
+	if (sensor->supplies_enabled || sensor->reset_error)
+		ret = gc08a8_power_off(dev);
+	if (!ret)
+		pm_runtime_set_suspended(dev);
+	mutex_unlock(sensor->ctrls.lock);
+}
+
 static int gc08a8_probe(struct i2c_client *client)
 {
 	struct device *dev = &client->dev;
@@ -848,9 +987,14 @@ static int gc08a8_probe(struct i2c_client *client)
 	ret = gc08a8_check_endpoint(dev);
 	if (ret)
 		return dev_err_probe(dev, ret, "Unsupported CSI-2 endpoint\n");
-	sensor = devm_kzalloc(dev, sizeof(*sensor), GFP_KERNEL);
+	sensor = kzalloc_obj(*sensor);
 	if (!sensor)
 		return -ENOMEM;
+	INIT_DELAYED_WORK(&sensor->power_off_work, gc08a8_retry_power_off);
+	kref_init(&sensor->ref);
+	ret = devm_add_action_or_reset(dev, gc08a8_put, sensor);
+	if (ret)
+		return ret;
 	sensor->regmap = devm_cci_regmap_init_i2c(client, 16);
 	if (IS_ERR(sensor->regmap))
 		return dev_err_probe(dev, PTR_ERR(sensor->regmap), "Failed to create regmap\n");
@@ -875,10 +1019,15 @@ static int gc08a8_probe(struct i2c_client *client)
 	sensor->pad.flags = MEDIA_PAD_FL_SOURCE;
 
 	ret = gc08a8_power_on(dev);
-	if (ret)
+	if (ret) {
+		if (sensor->power_error)
+			gc08a8_power_off(dev);
 		return dev_err_probe(dev, ret, "Failed to power sensor\n");
+	}
 	ret = cci_read(sensor->regmap, CCI_REG16(0x03f0), &id, NULL);
 	power_ret = gc08a8_power_off(dev);
+	if (power_ret)
+		power_ret = gc08a8_power_off(dev);
 	if (ret)
 		return dev_err_probe(dev, ret, "Failed to read sensor ID\n");
 	if (power_ret)
@@ -891,29 +1040,19 @@ static int gc08a8_probe(struct i2c_client *client)
 		return ret;
 	ret = media_entity_pads_init(&sensor->sd.entity, 1, &sensor->pad);
 	if (ret)
-		goto free_controls;
+		return ret;
 	sensor->sd.state_lock = sensor->ctrls.lock;
 	ret = v4l2_subdev_init_finalize(&sensor->sd);
 	if (ret)
-		goto clean_entity;
+		return ret;
 
 	ret = pm_runtime_set_suspended(dev);
 	if (ret)
-		goto clean_subdev;
+		return ret;
 	pm_runtime_enable(dev);
 	ret = v4l2_async_register_subdev_sensor(&sensor->sd);
 	if (ret)
-		goto disable_pm;
-	return 0;
-
-disable_pm:
-	pm_runtime_disable(dev);
-clean_subdev:
-	v4l2_subdev_cleanup(&sensor->sd);
-clean_entity:
-	media_entity_cleanup(&sensor->sd.entity);
-free_controls:
-	v4l2_ctrl_handler_free(&sensor->ctrls);
+		gc08a8_stop_pm(sensor);
 	return ret;
 }
 
@@ -923,13 +1062,7 @@ static void gc08a8_remove(struct i2c_client *client)
 	struct gc08a8 *sensor = to_gc08a8(sd);
 
 	v4l2_async_unregister_subdev(sd);
-	pm_runtime_disable(sd->dev);
-	/* Also cover residual resources from a failed runtime resume. */
-	if (!gc08a8_power_off(sd->dev))
-		pm_runtime_set_suspended(sd->dev);
-	v4l2_subdev_cleanup(sd);
-	media_entity_cleanup(&sd->entity);
-	v4l2_ctrl_handler_free(&sensor->ctrls);
+	gc08a8_stop_pm(sensor);
 }
 
 static int gc08a8_suspend(struct device *dev)
@@ -942,17 +1075,21 @@ static int gc08a8_suspend(struct device *dev)
 	state = v4l2_subdev_lock_and_get_active_state(sd);
 	if (sensor->streaming)
 		ret = -EBUSY;
-	else if (sensor->power_error)
-		ret = sensor->power_error;
-	else
+	else {
 		ret = pm_runtime_force_suspend(dev);
+		if (!ret && READ_ONCE(sensor->power_error)) {
+			ret = gc08a8_power_off(dev);
+			if (ret)
+				pm_runtime_force_resume(dev);
+		}
+	}
 	v4l2_subdev_unlock_state(state);
 	return ret;
 }
 
 static const struct dev_pm_ops gc08a8_pm_ops = {
 	SYSTEM_SLEEP_PM_OPS(gc08a8_suspend, pm_runtime_force_resume)
-	RUNTIME_PM_OPS(gc08a8_power_off, gc08a8_power_on, NULL)
+	RUNTIME_PM_OPS(gc08a8_runtime_suspend, gc08a8_runtime_resume, NULL)
 };
 
 static const struct of_device_id gc08a8_of_match[] = {
diff --git a/drivers/media/i2c/gt9764.c b/drivers/media/i2c/gt9764.c
index 9cb8cca..ee46893 100755
--- a/drivers/media/i2c/gt9764.c
+++ b/drivers/media/i2c/gt9764.c
@@ -3,10 +3,13 @@
 
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/kref.h>
 #include <linux/module.h>
 #include <linux/pm_runtime.h>
 #include <linux/property.h>
 #include <linux/regulator/consumer.h>
+#include <linux/slab.h>
+#include <linux/workqueue.h>
 #include <media/v4l2-async.h>
 #include <media/v4l2-ctrls.h>
 #include <media/v4l2-device.h>
@@ -19,13 +22,18 @@
 #define GT9764_POSITION_INIT	512
 
 struct gt9764 {
+	struct kref ref;
 	struct v4l2_subdev sd;
 	struct v4l2_ctrl_handler ctrls;
 	struct v4l2_ctrl *focus;
 	struct regulator_bulk_data supplies[2];
-	/* A disable error makes that reference's ownership unknowable. */
+	struct delayed_work power_off_work;
 	unsigned long supplies_enabled;
+	unsigned int power_off_retries;
+	int supply_error;
 	int power_error;
+	unsigned int open_count;
+	bool detached;
 	u32 aac_mode;
 	u32 aac_timing;
 	u32 settling_time;
@@ -36,6 +44,32 @@ static struct gt9764 *to_gt9764(struct v4l2_subdev *sd)
 	return container_of(sd, struct gt9764, sd);
 }
 
+static void gt9764_free(struct kref *ref)
+{
+	struct gt9764 *lens = container_of(ref, struct gt9764, ref);
+
+	media_entity_cleanup(&lens->sd.entity);
+	v4l2_ctrl_handler_free(&lens->ctrls);
+	kfree(lens);
+}
+
+static void gt9764_put(void *data)
+{
+	struct gt9764 *lens = data;
+
+	kref_put(&lens->ref, gt9764_free);
+}
+
+static void gt9764_devnode_get(struct v4l2_subdev *sd)
+{
+	kref_get(&to_gt9764(sd)->ref);
