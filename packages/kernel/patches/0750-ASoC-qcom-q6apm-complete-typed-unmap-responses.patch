From: 181981772 <181981772@qq.com>
Subject: [PATCH] ASoC: qcom: q6apm: complete typed UNMAP responses

UNMAP waits for APM_CMD_SHARED_MEM_UNMAP_REGIONS, but its basic response
stores the outer GPR_BASIC_RSP_RESULT opcode. A successful response cannot
satisfy the waiter. The callback also ignores DSP status and always clears
the ordinary buffer handle.

Complete with the command opcode and DSP status. Include the existing
position-buffer token bit in the request, mask the graph id at lookup, and
clear only the corresponding handle after success. Keep both handles on a
reported DSP error so local state does not claim a failed unmap completed.

Signed-off-by: 181981772 <181981772@qq.com>
---
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -335,8 +335,11 @@
 	struct q6apm *apm = dev_get_drvdata(dev->parent);
 	struct audioreach_graph_info *info;
 	uint32_t mem_map_handle;
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
-						APM_CMD_SHARED_MEM_UNMAP_REGIONS, graph_id);
+	u32 token = graph_id | (is_pos_buf ? APM_MMAP_TOKEN_MAP_TYPE_POS_BUF : 0);
+	struct gpr_pkt *pkt __free(kfree) = NULL;
+
+	pkt = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
+					   APM_CMD_SHARED_MEM_UNMAP_REGIONS, token);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
@@ -977,16 +980,23 @@
 			wake_up(&apm->wait);
 			break;
 		case APM_CMD_SHARED_MEM_UNMAP_REGIONS:
-			apm->result.opcode = hdr->opcode;
-			apm->result.status = 0;
-			rsp = data->payload;
-
-			info = idr_find(&apm->graph_info_idr, hdr->token);
-			if (info)
-				info->mem_map_handle = 0;
-			else
+			apm->result.opcode = result->opcode;
+			apm->result.status = result->status;
+
+			graph_id = hdr->token & APM_MMAP_TOKEN_GID_MASK;
+			is_pos_buf = hdr->token & APM_MMAP_TOKEN_MAP_TYPE_POS_BUF;
+			info = idr_find(&apm->graph_info_idr, graph_id);
+			if (!info) {
 				dev_err(dev, "Error (%d) Processing 0x%08x cmd\n", result->status,
 					result->opcode);
+			} else if (result->status) {
+				dev_err(dev, "Error (%d) Processing 0x%08x cmd\n", result->status,
+					result->opcode);
+			} else if (is_pos_buf) {
+				info->pos_buf_mem_map_handle = 0;
+			} else {
+				info->mem_map_handle = 0;
+			}
 
 			wake_up(&apm->wait);
 			break;
