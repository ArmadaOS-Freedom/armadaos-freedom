diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 8af5514..c3f0376 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -40,6 +40,43 @@ int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
 					NULL, &apm->wait, pkt, rsp_opcode);
 }
 
+static int q6apm_send_tracked_cmd(struct q6apm *apm, struct gpr_pkt *pkt)
+{
+	gpr_device_t *gdev = apm->gdev;
+	u32 opcode = pkt->hdr.opcode;
+	int ret;
+
+	/* Use the APM command mutex without its opcode-only result slot. */
+	lockdep_assert_held(&apm->lock);
+	spin_lock(&apm->reply_lock);
+	if (!++apm->reply_token)
+		apm->reply_token++;
+	pkt->hdr.token = apm->reply_token;
+	reinit_completion(&apm->reply_done);
+	apm->reply_opcode = opcode;
+	spin_unlock(&apm->reply_lock);
+
+	pkt->hdr.src_port = gdev->svc_id;
+	ret = gpr_send_pkt(gdev, pkt);
+	if (ret >= 0) {
+		if (!wait_for_completion_timeout(&apm->reply_done, 5 * HZ)) {
+			dev_err(apm->dev, "Command %#x timed out\n", opcode);
+			ret = -ETIMEDOUT;
+		} else if (apm->reply_status) {
+			dev_err(apm->dev, "Command %#x failed: %#x\n", opcode, apm->reply_status);
+			ret = -EINVAL;
+		} else {
+			ret = 0;
+		}
+	}
+
+	spin_lock(&apm->reply_lock);
+	apm->reply_opcode = 0;
+	spin_unlock(&apm->reply_lock);
+
+	return ret;
+}
+
 static void q6apm_put_audioreach_graph(struct kref *ref);
 
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
@@ -66,6 +103,7 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	if (!graph)
 		return ERR_PTR(-ENOMEM);
 
+	mutex_init(&graph->start_stop_lock);
 	graph->apm = apm;
 	graph->info = info;
 	graph->id = graph_id;
@@ -127,6 +165,15 @@ static int audioreach_graph_mgmt_cmd(struct audioreach_graph *graph, uint32_t op
 	list_for_each_entry(sg, &info->sg_list, node)
 		mgmt_cmd->sub_graph_id_list[i++] = sg->sub_graph_id;
 
+	if (opcode == APM_CMD_GRAPH_STOP) {
+		int ret;
+
+		mutex_lock(&apm->lock);
+		ret = q6apm_send_tracked_cmd(apm, pkt);
+		mutex_unlock(&apm->lock);
+		return ret;
+	}
+
 	return q6apm_send_cmd_sync(apm, pkt, 0);
 }
 
@@ -334,31 +381,40 @@ static int __q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int gr
 	struct apm_cmd_shared_mem_unmap_regions *cmd;
 	struct q6apm *apm = dev_get_drvdata(dev->parent);
 	struct audioreach_graph_info *info;
-	uint32_t mem_map_handle;
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
-						APM_CMD_SHARED_MEM_UNMAP_REGIONS, graph_id);
-	if (IS_ERR(pkt))
-		return PTR_ERR(pkt);
+	struct gpr_pkt *pkt __free(kfree) = NULL;
+	u32 mem_map_handle, *handle;
+	int ret;
 
+	/* Keep graph info and the selected mapping alive across the wait. */
+	mutex_lock(&apm->lock);
 	info = idr_find(&apm->graph_info_idr, graph_id);
-	if (!info)
-		return -ENODEV;
-
-	if (is_pos_buf) {
-		if (!info->pos_buf_mem_map_handle)
-			return 0;
-		mem_map_handle = info->pos_buf_mem_map_handle;
-	} else {
+	if (!info) {
+		ret = -ENODEV;
+		goto unlock;
+	}
+	handle = is_pos_buf ? &info->pos_buf_mem_map_handle : &info->mem_map_handle;
+	mem_map_handle = READ_ONCE(*handle);
+	if (!mem_map_handle) {
+		ret = 0;
+		goto unlock;
+	}
 
-		if (!info->mem_map_handle)
-			return 0;
-		mem_map_handle = info->mem_map_handle;
+	pkt = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd), APM_CMD_SHARED_MEM_UNMAP_REGIONS, 0);
+	if (IS_ERR(pkt)) {
+		ret = PTR_ERR(pkt);
+		goto unlock;
 	}
 
 	cmd = (void *)pkt + GPR_HDR_SIZE;
 	cmd->mem_map_handle = mem_map_handle;
 
-	return q6apm_send_cmd_sync(apm, pkt, APM_CMD_SHARED_MEM_UNMAP_REGIONS);
+	ret = q6apm_send_tracked_cmd(apm, pkt);
+	if (!ret)
+		cmpxchg(handle, mem_map_handle, 0);
+
+unlock:
+	mutex_unlock(&apm->lock);
+	return ret;
 }
 
 int q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int graph_id)
@@ -827,31 +883,49 @@ EXPORT_SYMBOL_GPL(q6apm_graph_prepare);
 int q6apm_graph_start(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
-	int ret;
+	int ret = 0;
+
+	mutex_lock(&ar_graph->start_stop_lock);
 
 	if (ar_graph->start_count == 0) {
 		ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_START);
 		if (ret)
-			return ret;
+			goto unlock;
 	}
 
 	ar_graph->start_count++;
 
-	return 0;
+unlock:
+	mutex_unlock(&ar_graph->start_stop_lock);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_start);
 
 int q6apm_graph_stop(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
+	int ret;
 
-	if (ar_graph->start_count == 0)
-		return 0;
+	mutex_lock(&ar_graph->start_stop_lock);
 
-	if (--ar_graph->start_count > 0)
-		return 0;
+	if (ar_graph->start_count == 0) {
+		ret = 0;
+		goto unlock;
+	}
+
+	if (ar_graph->start_count > 1) {
+		ar_graph->start_count--;
+		ret = 0;
+		goto unlock;
+	}
+
+	ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
+	if (!ret)
+		ar_graph->start_count--;
 
-	return audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
+unlock:
+	mutex_unlock(&ar_graph->start_stop_lock);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_stop);
 
@@ -897,6 +971,8 @@ static int apm_probe(gpr_device_t *gdev)
 	apm->dev = dev;
 	apm->gdev = gdev;
 	init_waitqueue_head(&apm->wait);
