From: 181981772 <181981772@qq.com>
Subject: [PATCH] ASoC: qcom: q6apm: harden capture and graph teardown

Capture prepare starts the frontend before the PCM START trigger. If an
application frees an already prepared stream, DPCM can shut down the
backend before the frontend's close callback stops its graph. Stop the
capture frontend during component hw_free and serialize the transition
with read requeue. Keep fragment ownership in close and reprepare.

Serialize shared graph START and STOP and keep the last reference on
failure. Use a distinct GPR transaction token for each STOP so a delayed
response cannot complete the next request. Abort PCM playback and LPASS
reprepare when STOP fails. Reject capture START after failed reprepare
until another prepare succeeds.

Complete UNMAP with the original command and DSP status, carrying the
ordinary or position-buffer type in the request. Clear only the handle
the DSP successfully unmapped.

DPCM still performs best-effort cleanup after a persistent hw_free
failure. This change does not make a timed-out DSP graph's state known
or change the lifetime of callbacks after final port teardown.

Signed-off-by: 181981772 <181981772@qq.com>
---
diff --git a/sound/soc/qcom/qdsp6/q6apm-dai.c b/sound/soc/qcom/qdsp6/q6apm-dai.c
index 82a5f78..a91e89a 100644
--- a/sound/soc/qcom/qdsp6/q6apm-dai.c
+++ b/sound/soc/qcom/qdsp6/q6apm-dai.c
@@ -81,6 +81,9 @@ struct q6apm_dai_rtd {
 	struct q6apm_graph *graph;
 	spinlock_t lock;
 	bool notify_on_drain;
+	bool graph_stopped;
+	bool capture_prepare_failed;
+	struct mutex capture_lock;	/* serializes capture read and STOP */
 };
 
 struct q6apm_dai_data {
@@ -137,7 +140,7 @@ static void event_handler(uint32_t opcode, uint32_t token, void *payload, void *
 		snd_pcm_period_elapsed(substream);
 		break;
 	case APM_CLIENT_EVENT_CMD_EOS_DONE:
-		prtd->state = Q6APM_STREAM_STOPPED;
+		WRITE_ONCE(prtd->state, Q6APM_STREAM_STOPPED);
 		break;
 	case APM_CLIENT_EVENT_DATA_WRITE_DONE:
 		snd_pcm_period_elapsed(substream);
@@ -145,8 +148,10 @@ static void event_handler(uint32_t opcode, uint32_t token, void *payload, void *
 		break;
 	case APM_CLIENT_EVENT_DATA_READ_DONE:
 		snd_pcm_period_elapsed(substream);
-		if (prtd->state == Q6APM_STREAM_RUNNING)
+		mutex_lock(&prtd->capture_lock);
+		if (READ_ONCE(prtd->state) == Q6APM_STREAM_RUNNING)
 			q6apm_read(prtd->graph);
+		mutex_unlock(&prtd->capture_lock);
 
 		break;
 	default:
@@ -211,19 +216,80 @@ static void event_handler_compr(uint32_t opcode, uint32_t token,
 	}
 }
 
+static int q6apm_dai_stop_capture(struct q6apm_dai_rtd *prtd)
+{
+	int ret;
+
+	mutex_lock(&prtd->capture_lock);
+	if (READ_ONCE(prtd->state) == Q6APM_STREAM_IDLE ||
+	    prtd->graph_stopped) {
+		mutex_unlock(&prtd->capture_lock);
+		return 0;
+	}
+
+	WRITE_ONCE(prtd->state, Q6APM_STREAM_STOPPED);
+	mutex_unlock(&prtd->capture_lock);
+
+	ret = q6apm_graph_stop(prtd->graph);
+	if (ret)
+		return ret;
+
+	mutex_lock(&prtd->capture_lock);
+	prtd->graph_stopped = true;
+	mutex_unlock(&prtd->capture_lock);
+	return 0;
+}
+
 static void q6apm_dai_release_graph(struct q6apm_dai_rtd *prtd, int stream)
 {
-	if (prtd->state)
+	int ret;
+
+	if (stream == SNDRV_PCM_STREAM_CAPTURE) {
+		ret = q6apm_dai_stop_capture(prtd);
+		if (ret)
+			dev_err(prtd->graph->dev,
+				"Failed to stop capture graph %d\n", ret);
+	} else if (READ_ONCE(prtd->state)) {
 		q6apm_graph_stop(prtd->graph);
+	}
 	q6apm_free_fragments(prtd->graph, stream);
 	q6apm_graph_close(prtd->graph);
 	prtd->graph = NULL;
-	prtd->state = Q6APM_STREAM_IDLE;
+	prtd->graph_stopped = false;
+	WRITE_ONCE(prtd->state, Q6APM_STREAM_IDLE);
 	prtd->queue_ptr = 0;
 	prtd->last_pos_index = 0;
 	prtd->push_pull_size = 0;
 }
 
+static int q6apm_dai_hw_free(struct snd_soc_component *component,
+			     struct snd_pcm_substream *substream)
+{
+	struct snd_pcm_runtime *runtime = substream->runtime;
+	struct q6apm_dai_rtd *prtd;
+	int ret;
+
+	/*
+	 * Capture prepare starts the FE before the BE trigger.  Stop the FE
+	 * while ASoC hw_free is still ahead of BE shutdown.  Keep the fragments
+	 * until close or the next prepare, matching their existing lifetime.
+	 */
+	if (substream->stream != SNDRV_PCM_STREAM_CAPTURE || !runtime)
+		return 0;
+
+	prtd = runtime->private_data;
+	if (!prtd || !prtd->graph)
+		return 0;
+
+	ret = q6apm_dai_stop_capture(prtd);
+	if (ret) {
+		dev_err(component->dev, "Failed to stop capture graph %d\n", ret);
+		return ret;
+	}
+
+	return 0;
+}
+
 static int q6apm_dai_prepare(struct snd_soc_component *component,
 			     struct snd_pcm_substream *substream)
 {
@@ -249,11 +315,27 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 	cfg.bit_width = prtd->bits_per_sample;
 	cfg.fmt = SND_AUDIOCODEC_PCM;
 	audioreach_set_default_channel_mapping(cfg.channel_map, runtime->channels);
-	if (prtd->state) {
-		/* clear the previous setup if any  */
-		q6apm_graph_stop(prtd->graph);
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
+		/* ALSA can leave a previously prepared PCM in PREPARED on error. */
+		WRITE_ONCE(prtd->capture_prepare_failed, true);
+		ret = q6apm_dai_stop_capture(prtd);
+		if (ret) {
+			dev_err(dev, "Failed to stop previous capture graph %d\n", ret);
+			return ret;
+		}
+		if (READ_ONCE(prtd->state) != Q6APM_STREAM_IDLE) {
+			/* clear the previous setup if any */
+			q6apm_free_fragments(prtd->graph, substream->stream);
+			prtd->graph_stopped = false;
+			WRITE_ONCE(prtd->state, Q6APM_STREAM_IDLE);
+		}
+	} else if (READ_ONCE(prtd->state) != Q6APM_STREAM_IDLE) {
+		/* clear the previous setup if any */
+		ret = q6apm_graph_stop(prtd->graph);
+		if (ret)
+			return ret;
 		q6apm_free_fragments(prtd->graph, substream->stream);
-		prtd->state = Q6APM_STREAM_IDLE;
+		WRITE_ONCE(prtd->state, Q6APM_STREAM_IDLE);
 	}
 
 	prtd->queue_ptr = 0;
@@ -311,6 +393,7 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 		dev_err(dev, "Failed to Start Graph %d\n", ret);
 		return ret;
 	}
+	prtd->graph_stopped = false;
 	if (!q6apm_is_graph_in_push_pull_mode(prtd->graph)) {
 		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE) {
 			int i;
@@ -321,7 +404,9 @@ static int q6apm_dai_prepare(struct snd_soc_component *component,
 	}
 
 	/* Now that graph as been prepared and started update the internal state accordingly */
-	prtd->state = Q6APM_STREAM_RUNNING;
+	WRITE_ONCE(prtd->state, Q6APM_STREAM_RUNNING);
+	if (substream->stream == SNDRV_PCM_STREAM_CAPTURE)
+		WRITE_ONCE(prtd->capture_prepare_failed, false);
 
 	return 0;
 }
@@ -333,7 +418,8 @@ static int q6apm_dai_ack(struct snd_soc_component *component, struct snd_pcm_sub
 	int i, ret = 0, avail_periods;
 
 	/* SYNC_PTR can get here before prepare has allocated fragments */
-	if (!prtd->graph || prtd->state == Q6APM_STREAM_IDLE)
+	if (!prtd->graph ||
+	    READ_ONCE(prtd->state) == Q6APM_STREAM_IDLE)
 		return 0;
 
 	if (q6apm_is_graph_in_push_pull_mode(prtd->graph))
@@ -365,10 +451,13 @@ static int q6apm_dai_trigger(struct snd_soc_component *component,
 	case SNDRV_PCM_TRIGGER_START:
 	case SNDRV_PCM_TRIGGER_RESUME:
 	case SNDRV_PCM_TRIGGER_PAUSE_RELEASE:
+		if (substream->stream == SNDRV_PCM_STREAM_CAPTURE &&
+		    READ_ONCE(prtd->capture_prepare_failed))
+			ret = -EPIPE;
 		break;
 	case SNDRV_PCM_TRIGGER_STOP:
 		/* TODO support be handled via SoftPause Module */
-		prtd->state = Q6APM_STREAM_STOPPED;
+		WRITE_ONCE(prtd->state, Q6APM_STREAM_STOPPED);
 		prtd->queue_ptr = 0;
 		prtd->last_pos_index = 0;
 		break;
@@ -407,6 +496,7 @@ static int q6apm_dai_open(struct snd_soc_component *component,
 		return -ENOMEM;
 
 	spin_lock_init(&prtd->lock);
+	mutex_init(&prtd->capture_lock);
 	prtd->substream = substream;
 	prtd->graph = q6apm_graph_open(dev, event_handler, prtd, graph_id, substream->stream);
 	if (IS_ERR(prtd->graph)) {
@@ -1091,6 +1181,7 @@ static const struct snd_soc_component_driver q6apm_fe_dai_component = {
 	.pcm_new	= q6apm_dai_pcm_new,
 	.pcm_free	= q6apm_dai_pcm_free,
 	.hw_params	= q6apm_dai_hw_params,
+	.hw_free	= q6apm_dai_hw_free,
 	.pointer	= q6apm_dai_pointer,
 	.trigger	= q6apm_dai_trigger,
 	.ack		= q6apm_dai_ack,
diff --git a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
index 11da559..717c8d4 100644
--- a/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
+++ b/sound/soc/qcom/qdsp6/q6apm-lpass-dais.c
@@ -252,9 +252,10 @@ static int q6apm_lpass_dai_prepare(struct snd_pcm_substream *substream, struct s
 	}
 
 	if (dai_data->is_port_started[dai->id]) {
-		q6apm_graph_stop(dai_data->graph[dai->id]);
+		rc = q6apm_graph_stop(dai_data->graph[dai->id]);
+		if (rc)
+			return rc;
 		dai_data->is_port_started[dai->id] = false;
-
 	}
 	dai_data->is_prepared[dai->id] = false;
 
diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 8af5514..cc2f040 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -40,6 +40,43 @@ int q6apm_send_cmd_sync(struct q6apm *apm, struct gpr_pkt *pkt,
 					NULL, &apm->wait, pkt, rsp_opcode);
 }
 
+static int q6apm_send_graph_stop(struct q6apm *apm, struct gpr_pkt *pkt)
+{
+	gpr_device_t *gdev = apm->gdev;
+	int ret;
+
+	/* Share the APM command mutex, but not its opcode-only result slot. */
+	mutex_lock(&apm->lock);
+	spin_lock(&apm->stop_reply_lock);
+	if (!++apm->stop_token)
+		apm->stop_token++;
+	pkt->hdr.token = apm->stop_token;
+	reinit_completion(&apm->stop_done);
+	apm->stop_pending = true;
+	spin_unlock(&apm->stop_reply_lock);
+
+	pkt->hdr.src_port = gdev->svc_id;
+	ret = gpr_send_pkt(gdev, pkt);
+	if (ret >= 0) {
+		if (!wait_for_completion_timeout(&apm->stop_done, 5 * HZ)) {
+			dev_err(apm->dev, "GRAPH_STOP timed out\n");
+			ret = -ETIMEDOUT;
+		} else if (apm->stop_status) {
+			dev_err(apm->dev, "GRAPH_STOP failed: %#x\n", apm->stop_status);
+			ret = -EINVAL;
+		} else {
+			ret = 0;
+		}
+	}
+
+	spin_lock(&apm->stop_reply_lock);
+	apm->stop_pending = false;
+	spin_unlock(&apm->stop_reply_lock);
+	mutex_unlock(&apm->lock);
+
+	return ret;
+}
+
 static void q6apm_put_audioreach_graph(struct kref *ref);
 
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
@@ -66,6 +103,7 @@ static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, ui
 	if (!graph)
 		return ERR_PTR(-ENOMEM);
 
+	mutex_init(&graph->start_stop_lock);
 	graph->apm = apm;
 	graph->info = info;
 	graph->id = graph_id;
@@ -127,6 +165,9 @@ static int audioreach_graph_mgmt_cmd(struct audioreach_graph *graph, uint32_t op
 	list_for_each_entry(sg, &info->sg_list, node)
 		mgmt_cmd->sub_graph_id_list[i++] = sg->sub_graph_id;
 
+	if (opcode == APM_CMD_GRAPH_STOP)
+		return q6apm_send_graph_stop(apm, pkt);
+
 	return q6apm_send_cmd_sync(apm, pkt, 0);
 }
 
@@ -335,8 +376,11 @@ static int __q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int gr
 	struct q6apm *apm = dev_get_drvdata(dev->parent);
 	struct audioreach_graph_info *info;
 	uint32_t mem_map_handle;
-	struct gpr_pkt *pkt __free(kfree) = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
-						APM_CMD_SHARED_MEM_UNMAP_REGIONS, graph_id);
+	u32 token = graph_id | (is_pos_buf ? APM_MMAP_TOKEN_MAP_TYPE_POS_BUF : 0);
+	struct gpr_pkt *pkt __free(kfree) = NULL;
+
+	pkt = audioreach_alloc_apm_cmd_pkt(sizeof(*cmd),
+					   APM_CMD_SHARED_MEM_UNMAP_REGIONS, token);
 	if (IS_ERR(pkt))
 		return PTR_ERR(pkt);
 
@@ -827,31 +871,49 @@ EXPORT_SYMBOL_GPL(q6apm_graph_prepare);
 int q6apm_graph_start(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
-	int ret;
+	int ret = 0;
+
+	mutex_lock(&ar_graph->start_stop_lock);
 
 	if (ar_graph->start_count == 0) {
 		ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_START);
 		if (ret)
-			return ret;
+			goto unlock;
 	}
 
 	ar_graph->start_count++;
 
-	return 0;
+unlock:
+	mutex_unlock(&ar_graph->start_stop_lock);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_start);
 
 int q6apm_graph_stop(struct q6apm_graph *graph)
 {
 	struct audioreach_graph *ar_graph = graph->ar_graph;
+	int ret;
 
-	if (ar_graph->start_count == 0)
-		return 0;
+	mutex_lock(&ar_graph->start_stop_lock);
 
-	if (--ar_graph->start_count > 0)
-		return 0;
+	if (ar_graph->start_count == 0) {
+		ret = 0;
+		goto unlock;
+	}
 
-	return audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
+	if (ar_graph->start_count > 1) {
+		ar_graph->start_count--;
+		ret = 0;
+		goto unlock;
+	}
+
+	ret = audioreach_graph_mgmt_cmd(ar_graph, APM_CMD_GRAPH_STOP);
+	if (!ret)
+		ar_graph->start_count--;
+
+unlock:
+	mutex_unlock(&ar_graph->start_stop_lock);
+	return ret;
 }
 EXPORT_SYMBOL_GPL(q6apm_graph_stop);
 
@@ -897,6 +959,8 @@ static int apm_probe(gpr_device_t *gdev)
 	apm->dev = dev;
 	apm->gdev = gdev;
 	init_waitqueue_head(&apm->wait);
+	spin_lock_init(&apm->stop_reply_lock);
+	init_completion(&apm->stop_done);
 
 	INIT_LIST_HEAD(&apm->widget_list);
 	idr_init(&apm->graph_idr);
@@ -967,7 +1031,6 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 		case APM_CMD_GRAPH_PREPARE:
 		case APM_CMD_GRAPH_CLOSE:
 		case APM_CMD_GRAPH_FLUSH:
-		case APM_CMD_GRAPH_STOP:
 		case APM_CMD_SET_CFG:
 			apm->result.opcode = result->opcode;
 			apm->result.status = result->status;
@@ -976,17 +1039,33 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 					result->opcode);
 			wake_up(&apm->wait);
 			break;
+		case APM_CMD_GRAPH_STOP:
+			spin_lock(&apm->stop_reply_lock);
+			if (apm->stop_pending && hdr->token == apm->stop_token) {
+				apm->stop_pending = false;
+				apm->stop_status = result->status;
+				complete(&apm->stop_done);
+			}
+			spin_unlock(&apm->stop_reply_lock);
+			break;
 		case APM_CMD_SHARED_MEM_UNMAP_REGIONS:
-			apm->result.opcode = hdr->opcode;
-			apm->result.status = 0;
-			rsp = data->payload;
+			apm->result.opcode = result->opcode;
+			apm->result.status = result->status;
 
-			info = idr_find(&apm->graph_info_idr, hdr->token);
-			if (info)
-				info->mem_map_handle = 0;
-			else
+			graph_id = hdr->token & APM_MMAP_TOKEN_GID_MASK;
+			is_pos_buf = hdr->token & APM_MMAP_TOKEN_MAP_TYPE_POS_BUF;
+			info = idr_find(&apm->graph_info_idr, graph_id);
+			if (!info) {
+				dev_err(dev, "Error (%d) Processing 0x%08x cmd\n", result->status,
+					result->opcode);
+			} else if (result->status) {
 				dev_err(dev, "Error (%d) Processing 0x%08x cmd\n", result->status,
 					result->opcode);
+			} else if (is_pos_buf) {
+				info->pos_buf_mem_map_handle = 0;
+			} else {
+				info->mem_map_handle = 0;
+			}
 
 			wake_up(&apm->wait);
 			break;
diff --git a/sound/soc/qcom/qdsp6/q6apm.h b/sound/soc/qcom/qdsp6/q6apm.h
index 9092359..3be54bf 100644
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -3,6 +3,8 @@
 #define __Q6APM_H__
 #include <linux/types.h>
 #include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/spinlock.h>
 #include <linux/slab.h>
 #include <linux/wait.h>
 #include <linux/kernel.h>
@@ -57,6 +59,12 @@ struct q6apm {
 	/* For Graph OPEN/START/STOP/CLOSE operations */
 	wait_queue_head_t wait;
 	struct gpr_ibasic_rsp_result_t result;
+	/* Match GRAPH_STOP replies to one request, even after a timeout. */
+	spinlock_t stop_reply_lock;
+	struct completion stop_done;
+	u32 stop_token;
+	u32 stop_status;
+	bool stop_pending;
 
 	struct mutex cmd_lock;
 	struct mutex lock;
@@ -86,6 +94,8 @@ struct audioreach_graph {
 	struct audioreach_graph_info *info;
 	uint32_t id;
 	int state;
+	/* Serialize graph START and STOP. */
+	struct mutex start_stop_lock;
 	int start_count;
 	/* Cached Graph data */
 	void *graph;
