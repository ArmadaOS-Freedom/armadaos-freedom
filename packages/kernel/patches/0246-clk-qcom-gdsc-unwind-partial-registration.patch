Subject: [PATCH] clk: qcom: gdsc: unwind partially registered domains

Remove every initialized domain and successful subdomain link if a
later initialization, action, link or provider publication fails. This
also makes new ICC acquisition/vote failures safe to retry without
abandoning registered genpd objects. Physical boot-on hardware state
and unsupported active-provider teardown remain separate constraints.

diff --git a/drivers/clk/qcom/gdsc.c b/drivers/clk/qcom/gdsc.c
index 95936c6..13f7784 100644
--- a/drivers/clk/qcom/gdsc.c
+++ b/drivers/clk/qcom/gdsc.c
@@ -670,7 +670,7 @@ static void gdsc_pm_subdomain_remove(struct gdsc_desc *desc, size_t num)
 int gdsc_register(struct gdsc_desc *desc,
 		  struct reset_controller_dev *rcdev, struct regmap *regmap)
 {
-	int i, ret;
+	int i, ret, initialized = 0;
 	struct genpd_onecell_data *data;
 	struct device *dev = desc->dev;
 	struct gdsc **scs = desc->scs;
@@ -721,7 +721,8 @@ int gdsc_register(struct gdsc_desc *desc,
 		scs[i]->rcdev = rcdev;
 		ret = gdsc_init(scs[i]);
 		if (ret)
-			return ret;
+			goto err_pm_genpd_remove;
+		initialized = i + 1;
 		if (of_machine_is_compatible("lenovo,baldur") && desc->pd_list &&
 		    scs[i]->pwrsts != PWRSTS_ON && pm_runtime_enabled(dev)) {
 			scs[i]->rpm_dev = dev;
@@ -732,7 +733,7 @@ int gdsc_register(struct gdsc_desc *desc,
 			}
 			ret = devm_add_action_or_reset(dev, gdsc_rpm_release, scs[i]);
 			if (ret)
-				return ret;
+				goto err_pm_genpd_remove;
 		}
 		data->domains[i] = &scs[i]->pd;
 	}
@@ -752,10 +753,18 @@ int gdsc_register(struct gdsc_desc *desc,
 			goto err_pm_subdomain_remove;
 	}
 
-	return of_genpd_add_provider_onecell(dev->of_node, data);
+	ret = of_genpd_add_provider_onecell(dev->of_node, data);
+	if (!ret)
+		return 0;
 
 err_pm_subdomain_remove:
 	gdsc_pm_subdomain_remove(desc, i);
+err_pm_genpd_remove:
+	/* Nothing may retain an initialized domain after a failed probe. */
+	for (i = initialized - 1; i >= 0; i--) {
+		if (scs[i])
+			pm_genpd_remove(&scs[i]->pd);
+	}
 
 	return ret;
 }
