Subject: [PATCH] media: i2c: add S5KJNS, GC08A8 and GT9764 support

Camera-only port from h0cheung/tb322fc-linux-kernel commit
dc7d14dc64c8d4f86220b30cd126b17d805c8474 (source head
bf96c3d4048973298ede78487177c6f1b4f6bc0f). Preserve the four-generation
supply and reset contracts, GRBG rear / RGGB front raw formats,
and the original sensor programming tables. The supported modes are
4080x3072 rear and 3264x2448 front; no complete hardware ISP is implied.

diff --git a/Documentation/devicetree/bindings/media/i2c/galaxycore,gc08a8.yaml b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc08a8.yaml
new file mode 100644
index 0000000..3ddcc16
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/galaxycore,gc08a8.yaml
@@ -0,0 +1,117 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+# Copyright (c) 2023 MediaTek Inc.
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/galaxycore,gc08a8.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: GalaxyCore gc08a8 1/4" 8M Pixel MIPI CSI-2 sensor
+
+maintainers:
+  - Elden Mainline Agent <elden-mainline@localhost>
+
+description:
+  The gc08a8 is a raw image sensor with an MIPI CSI-2 image data
+  interface and CCI (I2C compatible) control bus. The output format
+  is raw Bayer.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: galaxycore,gc08a8
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: 19.2 MHz input clock.
+
+  dovdd-supply: true
+
+  avdd-supply: true
+
+  dvdd-supply: true
+
+  power-domains:
+    maxItems: 1
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the RESETB pin.
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    description:
+      Output port node, single endpoint describing the CSI-2 transmitter.
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            items:
+              - const: 1
+              - const: 2
+              - const: 3
+              - const: 4
+
+          link-frequencies:
+            items:
+              - const: 336000000
+
+        required:
+          - data-lanes
+          - link-frequencies
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - dovdd-supply
+  - avdd-supply
+  - dvdd-supply
+  - reset-gpios
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@31 {
+            compatible = "galaxycore,gc08a8";
+            reg = <0x31>;
+
+            clocks = <&gc08a8_clk>;
+
+            reset-gpios = <&pio 19 GPIO_ACTIVE_LOW>;
+
+            avdd-supply = <&gc08a8_avdd>;
+            dovdd-supply = <&gc08a8_dovdd>;
+            dvdd-supply = <&gc08a8_dvdd>;
+
+            port {
+                sensor_out: endpoint {
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <336000000>;
+                    remote-endpoint = <&seninf_csi_port_0_in>;
+                };
+            };
+        };
+    };
+
+...
