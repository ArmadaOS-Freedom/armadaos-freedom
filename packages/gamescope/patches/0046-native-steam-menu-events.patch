+"""Spawn-level test for wlserver_open_steam_menu.
+
+wlserver_open_steam_menu must ask the native menu helper to inject the Guide
+or Quick Access gamepad button, because synthetic X11 keys open the menu in
+keyboard mode. This test extracts the real function body from
+src/wlserver.cpp, compiles it against a tiny gamescope::Process::SpawnProcess
+stub, and checks what the compositor would launch.
+
+The harness provides no X11 headers or libraries, so a keyboard-based
+implementation cannot even build here.
+
+Run inside a container that provides g++:
+
+    python3 -m unittest tests.test_steam_menu_dispatch -v
+"""
+
+import re
+import subprocess
+import tempfile
+import unittest
+from pathlib import Path
+
+SRC = Path(__file__).resolve().parents[1] / "src" / "wlserver.cpp"
+
+RUNNER_HEAD = r"""
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <functional>
+#include <string>
+#include <utility>
+#include <vector>
+#include <sys/types.h>
+
+struct SpawnRecord
+{
+	std::vector<std::string> argv;
+	bool bTerminated = false;
+	bool bHasPreamble = false;
+	bool bDoubleFork = false;
+};
+
+static std::vector<SpawnRecord> g_Records;
+
+namespace gamescope::Process
+{
+	pid_t SpawnProcess( char **argv, std::function<void()> fnPreambleInChild, bool bDoubleFork )
+	{
+		SpawnRecord record;
+
+		int i = 0;
+		for ( ; i < 8 && argv[ i ]; i++ )
+			record.argv.emplace_back( argv[ i ] );
+		record.bTerminated = i < 8 && argv[ i ] == nullptr;
+		record.bHasPreamble = static_cast<bool>( fnPreambleInChild );
+		record.bDoubleFork = bDoubleFork;
+
+		g_Records.emplace_back( std::move( record ) );
+		return 1;
+	}
+}
+
+/* ---- extracted production code ---- */
+"""
+
+RUNNER_MAIN = r"""
+/* ---- end extracted production code ---- */
+
+int main( int argc, char **argv )
+{
+	if ( argc < 2 )
+	{
+		fprintf( stderr, "usage: %s <0|1>\n", argv[0] );
+		return 2;
+	}
+	const bool bQam = argv[1][0] == '1';
+
+	wlserver_open_steam_menu( bQam );
+
+	const std::vector<std::string> vExpected = {
+		"/usr/libexec/armada/steam-menu",
+		bQam ? "qam" : "home",
+	};
+
+	printf( "mode=%s spawns=%zu\n", bQam ? "qam" : "home", g_Records.size() );
+	for ( size_t nRecord = 0; nRecord < g_Records.size(); nRecord++ )
+	{
+		for ( size_t i = 0; i < g_Records[ nRecord ].argv.size(); i++ )
+			printf( "  spawn[%zu] argv[%zu]=%s\n", nRecord, i, g_Records[ nRecord ].argv[ i ].c_str() );
+	}
+
+	if ( g_Records.size() != 1 )
+	{
+		printf( "  mismatch: %zu helper launches, expected 1\n", g_Records.size() );
+		return 1;
+	}
+
+	const SpawnRecord &record = g_Records.front();
+	bool bOk = true;
+	if ( record.argv != vExpected )
+	{
+		printf( "  mismatch: unexpected helper argv\n" );
+		bOk = false;
+	}
+	if ( !record.bTerminated )
+	{
+		printf( "  mismatch: argv is not nullptr-terminated\n" );
+		bOk = false;
+	}
+	if ( record.bHasPreamble )
+	{
+		printf( "  mismatch: helper was given a child preamble\n" );
+		bOk = false;
+	}
+	if ( !record.bDoubleFork )
+	{
+		printf( "  mismatch: bDoubleFork=false, the compositor would reap the menu helper\n" );
+		bOk = false;
+	}
+
+	return bOk ? 0 : 1;
+}
+"""
+
+
+def extract_function(text):
+    match = re.search(r"void[ \t]+wlserver_open_steam_menu[ \t]*\([ \t]*bool[ \t]+\w+[ \t]*\)", text)
+    if not match:
+        raise AssertionError("wlserver_open_steam_menu not found in wlserver.cpp")
+    start = text.index("{", match.end())
+    depth = 0
+    for pos in range(start, len(text)):
+        if text[pos] == "{":
+            depth += 1
+        elif text[pos] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[match.start():pos + 1]
+    raise AssertionError("unbalanced braces while extracting wlserver_open_steam_menu")
+
+
+class SteamMenuDispatchTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        cls.tmpdir = tempfile.TemporaryDirectory()
+        work = Path(cls.tmpdir.name)
+
+        source = SRC.read_text(encoding="utf-8")
+        (work / "runner.cpp").write_text(RUNNER_HEAD + extract_function(source) + RUNNER_MAIN, encoding="utf-8")
+        cls.binary = work / "runner"
+
+        build = subprocess.run(
+            ["g++", "-std=c++17", "-O0", "-o", str(cls.binary), str(work / "runner.cpp")],
+            capture_output=True, text=True)
+        if build.returncode != 0:
+            raise AssertionError(f"runner build failed:\n{build.stdout}\n{build.stderr}")
+
+    @classmethod
+    def tearDownClass(cls):
+        cls.tmpdir.cleanup()
+
+    def _run(self, qam):
+        result = subprocess.run([str(self.binary), "1" if qam else "0"],
+                                capture_output=True, text=True, timeout=30)
+        self.assertEqual(result.returncode, 0,
+                         f"dispatch failed for {'qam' if qam else 'home'}:\n{result.stdout}{result.stderr}")
+
+    def test_main_menu(self):
+        self._run(False)
+
+    def test_qam_menu(self):
+        self._run(True)
+
+
+if __name__ == "__main__":
+    unittest.main()
