+#[cfg(test)]
+mod tests {
+    use super::*;
+    use packed_struct::types::{Integer, SizedInteger};
+
+    fn test_device(preserve_digital_edges: bool) -> SteamDeckUhidDevice {
+        SteamDeckUhidDevice::new_with_config(SteamDeckConfig {
+            preserve_digital_edges,
+            ..Default::default()
+        })
+        .expect("device should be created without opening UHID")
+    }
+
+    fn button(button: GamepadButton, pressed: bool) -> NativeEvent {
+        NativeEvent::new(
+            Capability::Gamepad(Gamepad::Button(button)),
+            InputValue::Bool(pressed),
+        )
+    }
+
+    fn hat_y(y: f64) -> NativeEvent {
+        NativeEvent::new(
+            Capability::Gamepad(Gamepad::Axis(GamepadAxis::Hat0)),
+            InputValue::Vector2 {
+                x: None,
+                y: Some(y),
+            },
+        )
+    }
+
+    fn trigger(trigger: GamepadTrigger, value: f64) -> NativeEvent {
+        NativeEvent::new(
+            Capability::Gamepad(Gamepad::Trigger(trigger)),
+            InputValue::Float(value),
+        )
+    }
+
+    fn left_stick(x: f64, y: f64) -> NativeEvent {
+        NativeEvent::new(
+            Capability::Gamepad(Gamepad::Axis(GamepadAxis::LeftStick)),
+            InputValue::Vector2 {
+                x: Some(x),
+                y: Some(y),
+            },
+        )
+    }
+
+    fn digital_bit(report: &[u8; 64], byte: usize, mask: u8) -> bool {
+        report[byte] & mask != 0
+    }
+
+    fn frame(report: &[u8; 64]) -> u32 {
+        u32::from_le_bytes([report[4], report[5], report[6], report[7]])
+    }
+
+    #[test]
+    fn opt_in_preserves_button_press_release_repress() {
+        let mut device = test_device(true);
+
+        device
+            .write_event(button(GamepadButton::South, true))
+            .expect("press");
+        device
+            .write_event(button(GamepadButton::South, false))
+            .expect("release");
+        device
+            .write_event(button(GamepadButton::South, true))
+            .expect("repress");
+
+        assert_eq!(device.recorded_reports.len(), 3);
+        assert!(digital_bit(&device.recorded_reports[0], 8, 0x80));
+        assert!(!digital_bit(&device.recorded_reports[1], 8, 0x80));
+        assert!(digital_bit(&device.recorded_reports[2], 8, 0x80));
+        assert_eq!(frame(&device.recorded_reports[0]), 1);
+        assert_eq!(frame(&device.recorded_reports[1]), 2);
+        assert_eq!(frame(&device.recorded_reports[2]), 3);
+    }
+
+    #[test]
+    fn opt_in_preserves_hat0_up_neutral_up() {
+        let mut device = test_device(true);
+
+        device.write_event(hat_y(-1.0)).expect("up");
+        device.write_event(hat_y(0.0)).expect("neutral");
+        device.write_event(hat_y(-1.0)).expect("up again");
+
+        assert_eq!(device.recorded_reports.len(), 3);
+        assert!(digital_bit(&device.recorded_reports[0], 9, 0x01));
+        assert!(!digital_bit(&device.recorded_reports[1], 9, 0x01));
+        assert!(digital_bit(&device.recorded_reports[2], 9, 0x01));
+    }
+
+    #[test]
+    fn opt_in_preserves_left_trigger_digital_bit() {
+        let mut device = test_device(true);
+
+        device
+            .write_event(trigger(GamepadTrigger::LeftTrigger, 1.0))
+            .expect("press");
+        device
+            .write_event(trigger(GamepadTrigger::LeftTrigger, 0.0))
+            .expect("release");
+        device
+            .write_event(trigger(GamepadTrigger::LeftTrigger, 1.0))
+            .expect("repress");
+
+        assert_eq!(device.recorded_reports.len(), 3);
+        assert!(digital_bit(&device.recorded_reports[0], 8, 0x02));
+        assert!(!digital_bit(&device.recorded_reports[1], 8, 0x02));
+        assert!(digital_bit(&device.recorded_reports[2], 8, 0x02));
+    }
+
+    #[test]
+    fn opt_in_preserves_right_trigger_digital_bit() {
+        let mut device = test_device(true);
+
+        device
+            .write_event(trigger(GamepadTrigger::RightTrigger, 1.0))
+            .expect("press");
+        device
+            .write_event(trigger(GamepadTrigger::RightTrigger, 0.0))
+            .expect("release");
+        device
+            .write_event(trigger(GamepadTrigger::RightTrigger, 1.0))
+            .expect("repress");
+
+        assert_eq!(device.recorded_reports.len(), 3);
+        assert!(digital_bit(&device.recorded_reports[0], 8, 0x01));
+        assert!(!digital_bit(&device.recorded_reports[1], 8, 0x01));
+        assert!(digital_bit(&device.recorded_reports[2], 8, 0x01));
+    }
+
+    #[test]
+    fn duplicate_digital_state_and_pure_stick_wait_for_periodic_write() {
+        let mut device = test_device(true);
+
+        device
+            .write_event(button(GamepadButton::South, true))
+            .expect("press");
+        assert_eq!(device.recorded_reports.len(), 1);
+
+        // The same digital state must not produce another immediate report.
+        device
+            .write_event(button(GamepadButton::South, true))
+            .expect("duplicate press");
+        assert_eq!(device.recorded_reports.len(), 1);
+
+        // Pure analog changes must not produce an immediate report either.
+        device.write_event(left_stick(1.0, 1.0)).expect("stick");
+        assert_eq!(device.recorded_reports.len(), 1);
+
+        // The next periodic write must include the final analog value.
+        device.write_state().expect("periodic write");
+        assert_eq!(device.recorded_reports.len(), 2);
+        let report = device.recorded_reports[1];
+        assert_eq!(i16::from_le_bytes([report[48], report[49]]), i16::MAX);
+        assert_eq!(
+            i16::from_le_bytes([report[50], report[51]]),
+            i16::MIN + 1
+        );
+    }
+
+    #[test]
+    fn default_config_only_writes_on_periodic_write() {
+        let mut device = test_device(false);
+
+        device
+            .write_event(button(GamepadButton::South, true))
+            .expect("press");
+        device
+            .write_event(button(GamepadButton::South, false))
+            .expect("release");
+        device
+            .write_event(button(GamepadButton::South, true))
+            .expect("repress");
+        assert!(device.recorded_reports.is_empty());
+
+        device.write_state().expect("periodic write");
+        assert_eq!(device.recorded_reports.len(), 1);
+        assert!(digital_bit(&device.recorded_reports[0], 8, 0x80));
+        assert_eq!(frame(&device.recorded_reports[0]), 1);
+    }
+
+    #[test]
+    fn frame_wraps_without_skipping_values() {
+        let mut device = test_device(false);
+        device.state.frame = Integer::from_primitive(u32::MAX - 1);
+
+        device.write_state().expect("first write");
+        device.write_state().expect("wrap write");
+        device.write_state().expect("post-wrap write");
+
+        let frames: Vec<u32> = device.recorded_reports.iter().map(frame).collect();
+        assert_eq!(frames, vec![u32::MAX, 0, 1]);
+    }
+}
