+#[cfg(test)]
+mod preserve_digital_edges_tests {
+    use super::CompositeDeviceConfig;
+
+    fn parse(options: &str) -> CompositeDeviceConfig {
+        let yaml = format!(
+            "version: 1\nkind: CompositeDevice\nname: Freedom Touch Controller\nmatches: []\nsource_devices:\n  - group: gamepad\n{options}"
+        );
+        CompositeDeviceConfig::from_yaml(yaml).expect("should parse composite device config")
+    }
+
+    #[test]
+    fn missing_option_is_none() {
+        let config = parse("");
+        assert!(config.options.is_none());
+        assert_eq!(
+            config
+                .options
+                .as_ref()
+                .and_then(|options| options.preserve_digital_edges),
+            None
+        );
+    }
+
+    #[test]
+    fn false_option_parses() {
+        let config = parse("options:\n  preserve_digital_edges: false\n");
+        let options = config.options.expect("options should be present");
+        assert_eq!(options.preserve_digital_edges, Some(false));
+        assert!(!options.preserve_digital_edges.unwrap_or(false));
+    }
+
+    #[test]
+    fn true_option_parses() {
+        let config = parse("options:\n  preserve_digital_edges: true\n");
+        let options = config.options.expect("options should be present");
+        assert_eq!(options.preserve_digital_edges, Some(true));
+        assert!(options.preserve_digital_edges.unwrap_or(false));
+    }
+}
