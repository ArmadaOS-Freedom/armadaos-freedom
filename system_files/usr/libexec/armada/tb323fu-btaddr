# Apply the provisioned public Bluetooth address on TB323FU (lenovo,baldur).
# Keep the applied address in /var so it survives a different OSTree deployment.

ADDR_FILE=/etc/tb323fu/bt-address
STATE_FILE=/var/lib/armada/bluetooth/bt-address
MACHINE_ID_FILE=/etc/machine-id
COMPAT=/sys/firmware/devicetree/base/compatible
DEADLINE_SECONDS=55

export LC_ALL=C

warn() {
    printf '%s\n' "tb323fu-btaddr: $*" >&2
}

is_target() {
    [ -r "$COMPAT" ] || return 1
    tr '\000' '\n' < "$COMPAT" | grep -Fxq 'lenovo,baldur'
}

info_addr() {
    printf '\n' | timeout 2 btmgmt --index 0 info 2>/dev/null |
        awk 'tolower($1) == "addr" { print tolower($2); exit }'
}

if ! is_target; then
    exit 0
fi

read_address() {
    [ -f "$1" ] && [ -r "$1" ] || return 1
    sed -n '1p' "$1" | tr -d ' \t\r' | tr 'A-F' 'a-f'
}

derive_address() {
    id=$(cat "$MACHINE_ID_FILE" 2>/dev/null) || return 1
    [ "${#id}" -eq 32 ] || return 1
    case "$id" in
        *[!0-9a-fA-F]*|00000000000000000000000000000000) return 1 ;;
    esac
    id=$(printf '%s' "$id" | tr 'A-F' 'a-f')
    hash=$(printf 'tb323fu-bt:%s' "$id" | sha256sum) || return 1
    first=$(printf '%s' "$hash" | cut -c1-2)
    rest=$(printf '%s' "$hash" | cut -c3-12)
    # Set the locally administered bit and clear the multicast bit.
    printf '%02x%s\n' "$(( (0x$first | 2) & 254 ))" "$rest" | sed 's/../&:/g; s/:$//'
}

save_address() {
    if [ "$desired" = "$(read_address "$STATE_FILE")" ]; then
        return 0
    fi

    if (
        umask 077
        dir=${STATE_FILE%/*}
        mkdir -p "$dir" || exit 1
        tmp=$(mktemp "$dir/.bt-address.XXXXXX") || exit 1
        trap 'rm -f -- "$tmp"' EXIT
        printf '%s\n' "$desired" > "$tmp" && mv -fT -- "$tmp" "$STATE_FILE"
    ); then
        return 0
    fi
    warn "could not save Bluetooth address to $STATE_FILE"
    return 1
}

address_source=
if [ -e "$ADDR_FILE" ] || [ -L "$ADDR_FILE" ]; then
    address_source=$ADDR_FILE
elif [ -e "$STATE_FILE" ] || [ -L "$STATE_FILE" ]; then
    address_source=$STATE_FILE
fi

if [ -n "$address_source" ]; then
    desired=$(read_address "$address_source") || {
        warn "could not read $address_source"
        exit 1
    }
else
    desired=$(derive_address) || {
        warn "cannot initialize Bluetooth address without a valid machine-id"
        exit 1
    }
    address_source=$MACHINE_ID_FILE
fi

case "$desired" in
    00:00:00:00:00:00|ff:ff:ff:ff:ff:ff)
        warn "invalid Bluetooth address from $address_source"
        exit 1
        ;;
    [0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f]:[0-9a-f][0-9a-f])
        ;;
    *)
        warn "invalid Bluetooth address from $address_source"
        exit 1
        ;;
esac

command -v btmgmt >/dev/null 2>&1 || {
    warn "btmgmt is not available"
    exit 1
}

deadline=$(( $(date +%s) + DEADLINE_SECONDS ))

# The controller has no management address until initial setup has finished.
while :; do
    current=$(info_addr)
    [ -n "$current" ] && break
    if [ "$(date +%s)" -ge "$deadline" ]; then
        warn "timed out waiting for controller 0 management information"
        exit 1
    fi
    sleep 1
done

if [ "$current" = "$desired" ]; then
    save_address
    exit $?
fi

# Power the controller off before changing the public address.
while :; do
    power_output=$(printf '\n' | timeout 2 btmgmt --index 0 power off 2>/dev/null)
    if printf '%s\n' "$power_output" | grep -qi 'set powered complete'; then
        break
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
        warn "controller did not confirm power off"
        exit 1
    fi
    sleep 1
done

# HCI_AUTO_OFF may report off while the transport is still up for 2 seconds.
sleep 3
if [ "$(date +%s)" -ge "$deadline" ]; then
    warn "timed out before setting public address $desired"
    exit 1
fi

set_output=$(printf '\n' | timeout 2 btmgmt --index 0 public-addr "$desired" 2>/dev/null)
set_status=$?
if [ "$set_status" -ne 0 ] || ! printf '%s\n' "$set_output" | grep -qi 'set public address complete'; then
    warn "controller rejected public address change to $desired"
    [ -n "$set_output" ] && printf '%s\n' "$set_output" >&2
    exit 1
fi

# Acknowledgement is not proof; the address must read back exactly.
while :; do
    current=$(info_addr)
    if [ "$current" = "$desired" ]; then
        save_address
        exit $?
    fi
    if [ "$(date +%s)" -ge "$deadline" ]; then
        warn "controller did not adopt public address $desired (read back: ${current:-unavailable})"
        exit 1
    fi
    sleep 1
done
