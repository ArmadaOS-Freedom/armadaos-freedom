#!/usr/bin/env python3
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path

CONFIG = Path("/etc/armada/controller.conf")
SERVICE = "org.shadowblip.InputPlumber"
IFACE = "org.shadowblip.Input.CompositeDevice"
DEVICE_ENV = "/usr/libexec/armada/device-env"
CONTROLLER_TYPES = {
    "deck-uhid": "Steam Deck",
    "xbox-series": "Xbox Series",
    "xb360": "Xbox 360",
    "ds5": "DualSense",
}


def device_env():
    """Parse one device-env run into a {key: raw value} map.

    Returns an empty map when device-env is missing or fails so callers treat
    it exactly like an unset variable.
    """
    try:
        result = subprocess.run(
            [DEVICE_ENV],
            check=True,
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return {}
    values = {}
    for line in result.stdout.splitlines():
        key, sep, value = line.partition("=")
        if sep:
            values[key.strip()] = value
    return values


def available_types(env=None):
    if env is None:
        env = device_env()
    raw = ""
    value = env.get("ARMADA_IP_TARGETS", "")
    try:
        raw = shlex.split(value)[0] if value.strip() else ""
    except ValueError:
        raw = value.strip()
    types = []
    for item in raw.split(","):
        item = item.strip()
        if item in CONTROLLER_TYPES and item not in types:
            types.append(item)
    return types or list(CONTROLLER_TYPES)


def load_type(types):
    try:
        lines = CONFIG.read_text(encoding="utf-8", errors="replace").splitlines()
    except OSError:
        return types[0]
    value = ""
    for line in lines:
        key, sep, raw = line.partition("=")
        if sep and key.strip() == "controller_type":
            value = raw.strip()
            break
    return value if value in types else types[0]


def save_type(value):
    if value not in CONTROLLER_TYPES:
        raise ValueError(f"invalid controller type: {value}")
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG.with_name(f".{CONFIG.name}.tmp")
    tmp.write_text(f"controller_type={value}\n", encoding="utf-8")
    tmp.chmod(0o644)
    tmp.replace(CONFIG)


def _capped(timeout, deadline):
    """Return effective timeout (cap to remaining), or None if no time left."""
    if deadline is None:
        return timeout
    rem = deadline - time.monotonic()
    if rem <= 0:
        return None
    return min(timeout, rem)


def composite_paths(deadline=None):
    eff = _capped(2, deadline)
    if eff is None:
        return []
    try:
        result = subprocess.run(
            ["busctl", "--system", "tree", SERVICE],
            check=True,
            capture_output=True,
            text=True,
            timeout=eff,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    paths = []
    for line in result.stdout.splitlines():
        match = re.search(r"(/org/shadowblip/InputPlumber/CompositeDevice[0-9]+)", line)
        if match:
            paths.append(match.group(1))
    return sorted(set(paths))


def composite_name(path, deadline=None):
    eff = _capped(2, deadline)
    if eff is None:
        return ""
    try:
        result = subprocess.run(
            ["busctl", "--system", "get-property", SERVICE, path, IFACE, "Name"],
            check=True,
            capture_output=True,
            text=True,
            timeout=eff,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    parts = result.stdout.strip().split('"')
    return parts[1] if len(parts) >= 2 else ""


def current_target_paths(path, deadline=None):
    eff = _capped(2, deadline)
    if eff is None:
        return []
    try:
        result = subprocess.run(
            ["busctl", "--system", "get-property", SERVICE, path, IFACE, "TargetDevices"],
            check=True,
            capture_output=True,
            text=True,
            timeout=eff,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    return re.findall(r'"([^"]*)"', result.stdout)


def extra_targets(path, deadline=None):
    extras = []
    for target_path in current_target_paths(path, deadline=deadline):
        segment = target_path.rsplit("/", 1)[-1].rstrip("0123456789")
        if segment in ("keyboard", "mouse") and segment not in extras:
            extras.append(segment)
    return extras


def apply_type(value, deadline=None):
    paths = composite_paths(deadline=deadline)
    if not paths:
        return False
    ok = False
    unresolved = False
    for path in paths:
        # Read the composite name exactly once. Skip when the name cannot be
        # resolved (empty/falsy) so an unidentified plugin composite is never
        # retargeted, and skip the exact Freedom Touch plugin name because it
        # owns this virtual composite and feeds its deck-uhid target; leaving
        # physical controllers, including the G9, on the existing apply path.
        name = composite_name(path, deadline=deadline)
        if not name:
            unresolved = True
            continue
        if name == "Freedom Touch Controller":
            continue
        targets = [value] + extra_targets(path, deadline=deadline)
        eff = _capped(8, deadline)
        if eff is None:
            unresolved = True
            continue
        try:
            subprocess.run(
                ["busctl", "--system", "call", SERVICE, path, IFACE, "SetTargetDevices", "as", str(len(targets)), *targets],
                check=True,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                timeout=eff,
            )
            ok = True
        except (OSError, subprocess.SubprocessError):
            pass
    return ok and not unresolved


# Total wall-clock budget for a full apply_with_retry pass. Kept at 14s so the
# whole retry envelope fits comfortably inside the caller's 20s armada-control
# timeout even after the first available_types()/device_env() probe (5s).
APPLY_RETRY_BUDGET = 14.0


def apply_with_retry(value, deadline=None):
    """Retry apply_type until it succeeds or the shared deadline expires.

    When ``deadline`` is None a fresh monotonic deadline is derived from
    ``APPLY_RETRY_BUDGET``. Every subprocess call inside apply_type is capped
    to the remaining time and no call is started once the deadline has
    passed. Sleep is 0.5s capped to the remaining budget.
    """
    if deadline is None:
        deadline = time.monotonic() + APPLY_RETRY_BUDGET
    for _ in range(30):
        if time.monotonic() >= deadline:
            return False
        if apply_type(value, deadline=deadline):
            return True
        rem = deadline - time.monotonic()
        if rem <= 0:
            return False
        time.sleep(min(0.5, rem))
    return False


def main(argv):
    command = argv[1] if len(argv) > 1 else "get"
    if command == "get":
        print(load_type(available_types()))
        return 0
    if command == "set":
        types = available_types()
        if len(argv) != 3:
            print(f"usage: controller-type set <{'|'.join(types)}>", file=sys.stderr)
            return 2
        if argv[2] not in types:
            print(f"invalid controller type: {argv[2]}", file=sys.stderr)
            return 2
        if not apply_with_retry(argv[2]):
            return 1
        save_type(argv[2])
        return 0
    if command == "apply":
        env = device_env()
        if env.get("ARMADA_BUILTIN_GAMEPAD", "").strip() == "0":
            return 0
        return 0 if apply_with_retry(load_type(available_types(env))) else 1
    print("usage: controller-type get|set|apply", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
