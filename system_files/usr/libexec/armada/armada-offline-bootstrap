"""Deploy the offline-updater runtime on installations that do not ship it.

This helper is standalone: it imports only the Python standard library so it
can run before /usr/lib/armada/updates exists.  Invoke it isolated, e.g.

    python3 -I /path/to/armada-offline-bootstrap probe
    python3 -I /path/to/armada-offline-bootstrap install --bundle FILE --sha256 HEX

Exactly one JSON object is written to stdout; diagnostics go to stderr.
Nothing here runs the updater, writes boot state, touches partitions, changes
SSH/sudo policy or remounts the root filesystem.
"""

from __future__ import annotations

import hashlib
import hmac
import json
import os
import re
import shutil
import stat
import subprocess
import sys
import tarfile
import tempfile
import uuid
from pathlib import Path

SCHEMA_VERSION = 1
COMMAND_PROBE = 'probe'
COMMAND_INSTALL = 'install'

BUNDLE_NAME = 'armada-offline-updater'
EXTENSION_NAME = 'zzzzzz-armada-offline-updater'
EXTENSION_RELEASE = ('usr/lib/extension-release.d/extension-release.'
                     + EXTENSION_NAME)

ENTRY_PATH = 'usr/libexec/armada/armada-offline-update'
BOOT_TOOL_DIR = 'usr/libexec/armada/boot-tool'
BOOT_TOOL_PATH = BOOT_TOOL_DIR + '/armada-boot-tool'
AB_LIBRARY_PATH = 'usr/libexec/armada/libarmada-update-ab.so'
DTB_HELPER_PATH = 'usr/libexec/armada/kshim-build-boot.py'
ARMADA_OS_PATH = 'usr/lib/armada/armada_os.py'
UPDATE_LIB_PATH = 'usr/lib/armada/update-lib'
UPDATES_DIR = 'usr/lib/armada/updates'
# systemd-sysext merges /usr and /opt only, never /etc.  The bundle therefore
# carries the trusted key at a /usr path and the host /etc policy, when one
# exists, wins over it.  The bundle never writes /etc.
TRUST_KEY_PATH = 'usr/share/armada/updates/armadaos-freedom.pub'
HOST_TRUST_KEY_PATH = 'etc/pki/containers/armadaos-freedom.pub'
RUN_EXTENSIONS = 'run/extensions'
UPDATE_SERVICE_PATH = 'usr/share/dbus-1/system-services/org.armada.Updates.service'

CORE_MODULES = (
    # armada_os imports updates.client at module load time.
    'client.py',
    'offline_rpc.py',
    'offline_jobs.py',
    'offline_session.py',
    'offline_prepare.py',
    'offline_execute.py',
    'offline_recovery.py',
    'offline_payload.py',
    'offline_boot_writer.py',
    # Executed as a script by runtime_health during trial confirmation.
    'wayland_probe.py',
)
REQUIRED_FILES = (
    ENTRY_PATH,
    BOOT_TOOL_PATH,
    AB_LIBRARY_PATH,
    DTB_HELPER_PATH,
    ARMADA_OS_PATH,
    UPDATE_LIB_PATH,
    TRUST_KEY_PATH,
) + tuple(UPDATES_DIR + '/' + name for name in CORE_MODULES)

ALLOWED_EXACT = frozenset(REQUIRED_FILES)
ALLOWED_PREFIXES = (
    UPDATES_DIR + '/',
    BOOT_TOOL_DIR + '/',
)

# Model rules are copied from the boot payload device configuration; only the
# required tokens are needed to name the running model.
MODEL_RULES = (
    ('TB322FC', frozenset({'lenovo,elden', 'qcom,sm8750'})),
    ('TB323FU', frozenset({'lenovo,baldur', 'qcom,kaanapali'})),
)
SUPPORTED_ARCHITECTURES = frozenset({'aarch64', 'arm64'})
DEPENDENCIES = (
    ('openssl', ('/usr/bin/openssl',)),
    ('bootc', ('/usr/bin/bootc',)),
    ('ostree', ('/usr/bin/ostree',)),
    ('rpmOstree', ('/usr/bin/rpm-ostree',)),
    ('fdtget', ('/usr/bin/fdtget',)),
    ('fdtput', ('/usr/bin/fdtput',)),
    ('dtc', ('/usr/bin/dtc',)),
)
SYSEXT_PATHS = ('/usr/bin/systemd-sysext', '/bin/systemd-sysext')
OS_RELEASE_PATHS = ('usr/lib/os-release', 'etc/os-release')
SYSEXT_TIMEOUT_SECONDS = 180

MAX_BUNDLE_BYTES = 512 * 1024 * 1024
MAX_MEMBER_BYTES = 128 * 1024 * 1024
MAX_MANIFEST_BYTES = 4 * 1024 * 1024
MAX_MEMBERS = 4096
MAX_TEXT_BYTES = 256 * 1024
MAX_CAPABILITIES = 16
MAX_CAPABILITY_LENGTH = 64
_CHUNK = 1024 * 1024
_HEX64 = re.compile(r'[0-9a-f]{64}\Z', re.ASCII)
_VERSION = re.compile(r'(\d+(?:\.\d+)*)(?:[-+][0-9A-Za-z.+-]+)?\Z', re.ASCII)
_CAPABILITY = re.compile(r'[a-z0-9]+(?:-[a-z0-9]+)*\Z', re.ASCII)
_MANIFEST_KEYS = frozenset({'schemaVersion', 'bundle', 'version', 'format',
                            'entry', 'files'})
# Optional keys stay backward compatible: a bundle built before capabilities
# existed still installs, a bundle that declares them must do so cleanly.
_MANIFEST_OPTIONAL_KEYS = frozenset({'capabilities'})
_FILE_KEYS = frozenset({'path', 'bytes', 'sha256', 'mode'})
_MODES = frozenset({'0644', '0755'})
# extension-release is a shell-like key=value file.  Host os-release values are
# root-owned but still untrusted input here: only bare tokens are serialised,
# never quoted or escaped text that could carry a newline or extra assignment.
_OS_RELEASE_VALUE = re.compile(r'[A-Za-z0-9][A-Za-z0-9._+~:-]*\Z', re.ASCII)


class BootstrapError(RuntimeError):
    """A bootstrap request cannot be completed safely."""

    def __init__(self, code, message):
        super().__init__(message)
        self.code = code


def _p(base, relative):
    # Join under an explicit root without letting an absolute input escape it.
    return Path(base) / str(relative).lstrip('/')


def _is_root():
    return os.name == 'posix' and os.geteuid() == 0


def _architecture():
    import platform
    return platform.machine().strip().lower()


def _find(base, candidates):
    for relative in candidates:
        path = _p(base, relative)
        if path.is_symlink() or not path.is_file():
            continue
        if not os.access(path, os.X_OK):
            continue
        return path
    return None


def _read_text(base, relative, limit=MAX_TEXT_BYTES):
    path = _p(base, relative)
    if path.is_symlink():
        return None
    try:
        flags = os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0)
        fd = os.open(path, flags)
    except OSError:
        return None
    try:
        info = os.fstat(fd)
        if not stat.S_ISREG(info.st_mode) or info.st_size > limit:
            return None
        chunks = []
        total = 0
        while total < info.st_size:
            chunk = os.read(fd, min(_CHUNK, info.st_size - total))
            if not chunk:
                break
            chunks.append(chunk)
            total += len(chunk)
        return b''.join(chunks).decode('utf-8', 'replace')
    finally:
        os.close(fd)


def _read_os_release(base):
    for relative in OS_RELEASE_PATHS:
        text = _read_text(base, relative)
        if text is None:
            continue
        values = {}
        for line in text.splitlines():
            line = line.strip()
            if not line or line.startswith('#') or '=' not in line:
                continue
            key, _, value = line.partition('=')
            value = value.strip()
            if len(value) >= 2 and value[0] == value[-1] and value[0] in '"\'':
                value = value[1:-1]
            if key and value:
                values[key] = value
        if values.get('ID'):
            values['_path'] = relative
            return values
    return {}


def _read_compatible(base):
    text = _read_text(base, 'sys/firmware/devicetree/base/compatible')
    if text is None:
        return []
    tokens = []
    for raw in text.split('\x00'):
        token = raw.strip()
        if token and token not in tokens:
            tokens.append(token)
    return tokens


def _select_model(compatible):
    present = set(compatible)
    matches = [model for model, required in MODEL_RULES if required <= present]
    return matches[0] if len(matches) == 1 else None


def _read_updater_version(base):
    text = _read_text(base, UPDATES_DIR + '/offline_session.py')
    if text is None:
        return None
    for line in text.splitlines():
        if line.startswith("_UPDATER_VERSION = '") and line.endswith("'"):
            return line[len("_UPDATER_VERSION = '"):-1]
    return None


def _version_tuple(value):
    if not isinstance(value, str):
        return None
    match = _VERSION.match(value.strip())
    if match is None:
        return None
    return tuple(int(part) for part in match.group(1).split('.'))


def _version_compare(left, right):
    left_parts = _version_tuple(left)
    right_parts = _version_tuple(right)
    if left_parts is None or right_parts is None:
        return None
    width = max(len(left_parts), len(right_parts))
    left_parts += (0,) * (width - len(left_parts))
    right_parts += (0,) * (width - len(right_parts))
    return (left_parts > right_parts) - (left_parts < right_parts)


def _missing_runtime(base):
    """Required runtime paths absent below base.

    A host that still carries the /etc policy key does not need the key the
    extension ships, because the runtime prefers the /etc one.
    """
    missing = [relative for relative in REQUIRED_FILES
               if not _is_regular(_p(base, relative))]
    if TRUST_KEY_PATH in missing and _is_regular(_p(base, HOST_TRUST_KEY_PATH)):
        missing.remove(TRUST_KEY_PATH)
    return missing


def _is_regular(path):
    if path.is_symlink():
        return False
    try:
        return stat.S_ISREG(path.stat().st_mode)
    except OSError:
        return False


def _extension_active(base):
    return _is_regular(_p(base, EXTENSION_RELEASE))


def _extension_dir(base):
    return _p(base, RUN_EXTENSIONS + '/' + EXTENSION_NAME)


def _runtime_root(base):
    """Root that actually holds the updater runtime for reading its files."""
    extension = _extension_dir(base)
    if _extension_active(base) and extension.is_dir() and not extension.is_symlink():
        return extension
    return Path(base)


def _sha256_file(path):
    digest = hashlib.sha256()
    with path.open('rb') as stream:
        while True:
            chunk = stream.read(_CHUNK)
            if not chunk:
                break
            digest.update(chunk)
    return digest.hexdigest()


def _verify_runtime(base, specs):
    """Return the manifest paths whose installed file does not match its claim.

    Reusing a runtime because its version string matches is not proof that the
    shipped files are the ones the bundle describes.
    """
    problems = []
    host_key = _is_regular(_p(base, HOST_TRUST_KEY_PATH))
    for relative in sorted(specs):
        spec = specs[relative]
        if relative == TRUST_KEY_PATH and host_key:
            # An existing /etc policy key is the anchor in effect.
            continue
        path = _p(base, relative)
        if not _is_regular(path):
            problems.append(relative)
            continue
        try:
            info = path.stat()
            if info.st_size != spec['bytes']:
                problems.append(relative)
                continue
            if stat.S_IMODE(info.st_mode) != int(spec['mode'], 8):
                problems.append(relative)
                continue
            if _sha256_file(path) != spec['sha256']:
                problems.append(relative)
        except OSError:
            problems.append(relative)
    return problems


def _read_bytes(path, limit):
    if not _is_regular(path):
        return None
    try:
        if path.stat().st_size > limit:
            return None
        return path.read_bytes()
    except OSError:
        return None


def _trust_anchor(base):
    """Return (relative path, source) for the trusted key in effect.

    The host /etc policy wins whenever it exists; the key shipped inside the
    extension is only a fallback for hosts that never had one.
    """
    if _is_regular(_p(base, HOST_TRUST_KEY_PATH)):
        return HOST_TRUST_KEY_PATH, 'etc'
    if _is_regular(_p(base, TRUST_KEY_PATH)):
        return TRUST_KEY_PATH, 'packaged'
    return (HOST_TRUST_KEY_PATH, None)


def _trust_files_differ(host_root, bundled_root):
    """True when both key files exist and hold different bytes."""
    host = _p(host_root, HOST_TRUST_KEY_PATH)
    bundled = _p(bundled_root, TRUST_KEY_PATH)
    if not _is_regular(host) or not _is_regular(bundled):
        return False
    host_pem = _read_bytes(host, MAX_TEXT_BYTES)
    bundled_pem = _read_bytes(bundled, MAX_TEXT_BYTES)
    if host_pem is None or bundled_pem is None:
        return False
    return host_pem != bundled_pem


def _host_key_mismatch(base, specs):
    """True when the host /etc key differs from the key the bundle ships."""
    spec = specs.get(TRUST_KEY_PATH)
    host = _p(base, HOST_TRUST_KEY_PATH)
    if spec is None or not _is_regular(host):
        return False
    try:
        if host.stat().st_size != spec['bytes']:
            return True
        return _sha256_file(host) != spec['sha256']
    except OSError:
        return False


def _extension_usable(directory):
    if directory.is_symlink():
        return False
    if directory.is_dir():
        return os.access(directory, os.W_OK | os.X_OK)
    return not directory.exists() and os.access(directory.parent, os.W_OK | os.X_OK)


# --------------------------------------------------------------------------
# probe


def probe(*, root='/', runner=None):
    """Report platform, dependency and updater state without changing anything."""
    base = Path(root)
    os_release = _read_os_release(base)
    compatible = _read_compatible(base)
    model = _select_model(compatible)
    architecture = _architecture()

    connection_reasons = []
    if not _is_root():
        connection_reasons.append('not-root')
    if not os_release:
        connection_reasons.append('missing-os-release')
    sysext = _find(base, SYSEXT_PATHS)
    if sysext is None:
        connection_reasons.append('missing-systemd-sysext')
    extensions = _p(base, 'run/extensions')
    if not _extension_usable(extensions):
        connection_reasons.append('extensions-dir-unusable')

    upgrade_reasons = []
    if not compatible:
        upgrade_reasons.append('missing-devicetree-compatible')
    elif model is None:
        upgrade_reasons.append('unsupported-model')
    if architecture not in SUPPORTED_ARCHITECTURES:
        upgrade_reasons.append('unsupported-architecture')
    trust_path, trust_source = _trust_anchor(base)

    missing = _missing_runtime(base)
    version = _read_updater_version(base)
    release_file = _read_text(base, 'usr/lib/armada/version')
    release_version = release_file.strip()[:64] if release_file else None
    if _extension_active(base):
        source = 'extension'
    elif _is_regular(_p(base, ENTRY_PATH)):
        source = 'native'
    else:
        source = None
    # The current update service is reported on its own: its absence is not a
    # platform limitation and must not hide an unsupported model or dependency.
    service_present = _is_regular(_p(base, UPDATE_SERVICE_PATH))

    dependencies = {
        'python3': {'present': True, 'version': '%d.%d.%d' % sys.version_info[:3]},
        'systemdSysext': {'present': sysext is not None,
                          'path': str(sysext) if sysext is not None else None},
    }
    for name, candidates in DEPENDENCIES:
        found = _find(base, candidates)
        dependencies[name] = {'present': found is not None,
                              'path': str(found) if found is not None else None}

    existing = []
    if extensions.is_dir() and not extensions.is_symlink():
        for child in sorted(extensions.iterdir()):
            if child.name == EXTENSION_NAME or child.name.startswith('.' + EXTENSION_NAME):
                continue
            existing.append(child.name)

    return {
        'schemaVersion': SCHEMA_VERSION,
        'ok': True,
        'command': COMMAND_PROBE,
        'connection': {
            'ready': not connection_reasons,
            'reasons': connection_reasons,
        },
        'upgrade': {
            # Eligibility is a platform property; connection.ready says whether
            # this particular session can deploy.  Keep the two separate so a
            # non-root probe cannot be mistaken for an unsupported device.
            'eligible': not upgrade_reasons,
            'reasons': upgrade_reasons,
            'tokensEvaluated': False,
        },
        'system': {
            'model': model,
            'compatible': compatible,
            'architecture': architecture,
            'version': (release_version or os_release.get('IMAGE_VERSION')
                        or os_release.get('VERSION')),
            'osId': os_release.get('ID'),
            'osVersionId': os_release.get('VERSION_ID'),
            'osReleasePath': os_release.get('_path'),
        },
        'dependencies': dependencies,
        'extensions': {
            'directory': str(extensions),
            'target': EXTENSION_NAME,
            'targetInstalled': _extension_active(base),
            'others': existing,
        },
        'updater': {
            'entryPresent': _is_regular(_p(base, ENTRY_PATH)),
            'version': version,
            'source': source,
            'capable': not missing and _version_tuple(version) is not None,
            'missing': missing,
        },
        'service': {
            # Whether the host already runs the current update service.  Kept
            # apart from upgrade.eligible and from dependency presence.
            'present': service_present,
            'path': str(_p(base, UPDATE_SERVICE_PATH)),
            'reasons': [] if service_present else ['missing-update-service'],
        },
        'trust': {
            'keyPath': str(_p(base, trust_path)),
            'present': trust_source is not None,
            'source': trust_source,
            # Both keys present but different: /etc policy is kept as-is and the
            # packaged key is ignored.  Reported, never switched silently.
            'conflict': _trust_files_differ(base, base),
            # A missing key is not a platform limitation: the bundle ships one
            # under /usr for hosts that never had a /etc policy key.
            'reasons': [] if trust_source is not None else ['missing-trust-anchor'],
        },
        'notes': [
            'legacy boot witness and deployment tokens are not evaluated by this helper',
        ],
    }


