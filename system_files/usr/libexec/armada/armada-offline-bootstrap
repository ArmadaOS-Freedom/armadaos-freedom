# install


def _check_member_name(name):
    if not isinstance(name, str) or not name or len(name) > 255:
        raise BootstrapError('archive_path_rejected', 'invalid archive member name')
    if name.startswith('/') or '\\' in name or ':' in name:
        raise BootstrapError('archive_path_rejected',
                             'archive member is not a safe relative path: %r' % name)
    if any(ord(character) < 32 or ord(character) == 127 for character in name):
        raise BootstrapError('archive_path_rejected',
                             'archive member has control characters: %r' % name)
    if any(part in ('', '.', '..') for part in name.split('/')):
        raise BootstrapError('archive_path_rejected',
                             'archive member traverses outside the extension: %r' % name)


def _allowed_member(name):
    if name in ALLOWED_EXACT:
        return True
    for prefix in ALLOWED_PREFIXES:
        if name.startswith(prefix) and len(name) > len(prefix):
            if prefix == UPDATES_DIR + '/':
                directory, _sep, filename = name.rpartition('/')
                return directory == UPDATES_DIR and filename.endswith('.py')
            return True
    return False


def _validate_capabilities(document):
    """Validate an optional capability list without requiring any of them.

    The helper is the install side, not the policy side: it accepts bundles
    that predate capabilities and bundles that declare new ones, but it never
    guesses at a malformed claim.
    """
    if 'capabilities' not in document:
        return
    value = document['capabilities']
    if type(value) is not list or len(value) > MAX_CAPABILITIES:
        raise BootstrapError('manifest_invalid',
                             'manifest capabilities must be a bounded list')
    seen = set()
    for capability in value:
        if (type(capability) is not str or not capability
                or len(capability) > MAX_CAPABILITY_LENGTH
                or not _CAPABILITY.fullmatch(capability)):
            raise BootstrapError('manifest_invalid',
                                 'manifest capability is not a valid token')
        if capability in seen:
            raise BootstrapError('manifest_invalid',
                                 'manifest capabilities must be unique')
        seen.add(capability)


def _parse_manifest(raw):
    try:
        document = json.loads(raw.decode('utf-8'))
    except (UnicodeDecodeError, ValueError) as error:
        raise BootstrapError('manifest_invalid', 'manifest is not valid JSON: %s' % error)
    if (not isinstance(document, dict) or not _MANIFEST_KEYS <= set(document)
            or set(document) - _MANIFEST_KEYS - _MANIFEST_OPTIONAL_KEYS):
        raise BootstrapError('manifest_invalid', 'manifest has an unexpected key set')
    if document.get('schemaVersion') != SCHEMA_VERSION:
        raise BootstrapError('manifest_invalid', 'manifest schemaVersion must be %d'
                             % SCHEMA_VERSION)
    if document.get('bundle') != BUNDLE_NAME:
        raise BootstrapError('manifest_invalid', 'manifest bundle name mismatch')
    if _version_tuple(document.get('version')) is None:
        raise BootstrapError('manifest_invalid', 'manifest version is not a version string')
    if document.get('format') not in ('tar', 'tar.gz'):
        raise BootstrapError('manifest_invalid', 'manifest format is unsupported')
    if document.get('entry') != ENTRY_PATH:
        raise BootstrapError('manifest_invalid', 'manifest entry point mismatch')
    if not isinstance(document.get('files'), list) or not document['files']:
        raise BootstrapError('manifest_invalid', 'manifest files must be a non-empty list')
    _validate_capabilities(document)
    return document


def _scan_archive(stream):
    stream.seek(0)
    members = {}
    manifest = None
    with tarfile.open(fileobj=stream, mode='r:*') as archive:
        for member in archive:
            name = member.name
            _check_member_name(name)
            if name in members:
                raise BootstrapError('archive_member_rejected',
                                     'duplicate archive member: %s' % name)
            if not member.isreg():
                raise BootstrapError('archive_member_rejected',
                                     'only regular files are allowed: %s' % name)
            if name == 'manifest.json':
                if manifest is not None:
                    raise BootstrapError('archive_member_rejected',
                                         'duplicate manifest.json')
                if not 0 < member.size <= MAX_MANIFEST_BYTES:
                    raise BootstrapError('manifest_invalid', 'manifest size is out of bounds')
                manifest = _parse_manifest(archive.extractfile(member).read())
            else:
                if not _allowed_member(name):
                    raise BootstrapError('archive_path_rejected',
                                         'archive member is not allowlisted: %s' % name)
                if not 0 <= member.size <= MAX_MEMBER_BYTES:
                    raise BootstrapError('archive_member_rejected',
                                         'archive member size is out of bounds: %s' % name)
            members[name] = member.size
            if len(members) > MAX_MEMBERS:
                raise BootstrapError('archive_member_rejected', 'archive has too many members')
    if manifest is None:
        raise BootstrapError('manifest_invalid', 'archive has no manifest.json')
    return manifest, members


def _validate_manifest(manifest, members):
    files = manifest['files']
    specs = {}
    previous = None
    for entry in files:
        if not isinstance(entry, dict) or set(entry) != _FILE_KEYS:
            raise BootstrapError('manifest_invalid', 'manifest file entry has an invalid key set')
        path = entry.get('path')
        _check_member_name(path)
        if path == 'manifest.json':
            raise BootstrapError('manifest_invalid', 'manifest must not list itself')
        if not _allowed_member(path):
            raise BootstrapError('archive_path_rejected',
                                 'manifest path is not allowlisted: %s' % path)
        if previous is not None and path <= previous:
            raise BootstrapError('manifest_invalid', 'manifest paths must be sorted and unique')
        previous = path
        if type(entry.get('bytes')) is not int or not 0 <= entry['bytes'] <= MAX_MEMBER_BYTES:
            raise BootstrapError('manifest_invalid',
                                 'manifest byte count is out of bounds: %s' % path)
        if not isinstance(entry.get('sha256'), str) or not _HEX64.fullmatch(entry['sha256']):
            raise BootstrapError('manifest_invalid',
                                 'manifest digest is malformed: %s' % path)
        if entry.get('mode') not in _MODES:
            raise BootstrapError('manifest_invalid', 'manifest mode is unsupported: %s' % path)
        specs[path] = entry

    payload = set(members) - {'manifest.json'}
    if set(specs) != payload:
        raise BootstrapError('manifest_mismatch',
                             'manifest does not describe exactly the archived files')
    for entry in specs.values():
        if members[entry['path']] != entry['bytes']:
            raise BootstrapError('manifest_mismatch',
                                 'manifest size differs from archive member: %s' % entry['path'])
    if sum(entry['bytes'] for entry in specs.values()) > MAX_BUNDLE_BYTES:
        raise BootstrapError('archive_member_rejected', 'bundle payload is too large')
    for relative in REQUIRED_FILES:
        if relative not in specs:
            raise BootstrapError('manifest_mismatch',
                                 'bundle is missing required runtime path: %s' % relative)
    return specs


def _mkdirs(directory):
    os.makedirs(directory, mode=0o755, exist_ok=True)


def _extract(stream, stage, specs):
    stream.seek(0)
    required = set(specs)
    written = set()
    with tarfile.open(fileobj=stream, mode='r:*') as archive:
        for member in archive:
            name = member.name
            if name == 'manifest.json':
                continue
            spec = specs.get(name)
            if spec is None or member.size != spec['bytes']:
                raise BootstrapError('manifest_mismatch',
                                     'archive member changed after manifest validation: %s' % name)
            target = stage / name
            if target.exists() or target.is_symlink():
                raise BootstrapError('archive_path_rejected',
                                     'duplicate extraction target: %s' % name)
            _mkdirs(target.parent)
            source = archive.extractfile(member)
            digest = hashlib.sha256()
            total = 0
            flags = (os.O_WRONLY | os.O_CREAT | os.O_EXCL
                     | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0))
            fd = os.open(target, flags, 0o600)
            try:
                while True:
                    chunk = source.read(_CHUNK)
                    if not chunk:
                        break
                    total += len(chunk)
                    if total > spec['bytes']:
                        raise BootstrapError('manifest_mismatch',
                                             'archive member exceeds its declared size: %s' % name)
                    digest.update(chunk)
                    view = memoryview(chunk)
                    while view:
                        count = os.write(fd, view)
                        if count <= 0:
                            raise BootstrapError('stage_failed', 'short write: %s' % name)
                        view = view[count:]
                if total != spec['bytes'] or digest.hexdigest() != spec['sha256']:
                    raise BootstrapError('manifest_mismatch',
                                         'archive member digest mismatch: %s' % name)
                os.fchmod(fd, int(spec['mode'], 8))
                os.fsync(fd)
            finally:
                os.close(fd)
            written.add(name)
            if written == required:
                break
    if written != required:
        raise BootstrapError('manifest_mismatch',
                             'archive is missing files declared by the manifest')


def _extension_release(os_release):
    """Serialise the host identity into an extension-release file.

    Only bare key tokens are emitted.  A host value carrying a newline, quote,
    backslash or assignment is rejected instead of being interpolated.
    """
    identifier = os_release.get('ID')
    if not identifier:
        raise BootstrapError('input_missing', 'host os-release has no ID')
    if not _OS_RELEASE_VALUE.fullmatch(identifier):
        raise BootstrapError('input_invalid',
                             'host os-release ID is not a safe extension-release value: %r'
                             % identifier)
    lines = ['# managed by armada-offline-bootstrap', 'ID=' + identifier]
    for key in ('VERSION_ID', 'SYSEXT_LEVEL'):
        value = os_release.get(key)
        if not value:
            continue
        if not _OS_RELEASE_VALUE.fullmatch(value):
            raise BootstrapError('input_invalid',
                                 'host os-release %s is not a safe extension-release value: %r'
                                 % (key, value))
        lines.append('%s=%s' % (key, value))
    return ('\n'.join(lines) + '\n').encode('utf-8')


def _write_file(path, data, mode):
    flags = (os.O_WRONLY | os.O_CREAT | os.O_EXCL
             | getattr(os, 'O_NOFOLLOW', 0) | getattr(os, 'O_CLOEXEC', 0))
    fd = os.open(path, flags, 0o600)
    try:
        view = memoryview(data)
        while view:
            count = os.write(fd, view)
            if count <= 0:
                raise BootstrapError('stage_failed', 'short write: %s' % path)
            view = view[count:]
        os.fchmod(fd, mode)
        os.fsync(fd)
    finally:
        os.close(fd)


def _fsync_dir(path):
    try:
        fd = os.open(path, os.O_RDONLY | getattr(os, 'O_DIRECTORY', 0))
    except OSError:
        return
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


def _refresh(runner, sysext):
    completed = runner([str(sysext), 'refresh'], capture_output=True, check=False,
                       timeout=SYSEXT_TIMEOUT_SECONDS)
    return getattr(completed, 'returncode', 1) == 0


def _new_stage(extensions):
    """Create a stage directory that belongs to this invocation only."""
    try:
        path = tempfile.mkdtemp(prefix='.' + EXTENSION_NAME + '.stage.', dir=str(extensions))
    except OSError as error:
        raise BootstrapError('stage_failed', 'cannot create a staging directory: %s' % error)
    return Path(path)


def _new_backup(extensions):
    """Return an unused backup name; never reuse a directory found on disk."""
    for _attempt in range(16):
        candidate = extensions / ('.' + EXTENSION_NAME + '.old.' + uuid.uuid4().hex[:12])
        if not candidate.exists() and not candidate.is_symlink():
            return candidate
    raise BootstrapError('stage_failed', 'cannot reserve a backup path')


def _install_extension(stage, final):
    """Move the staged tree into place, keeping the old extension on failure."""
    backup = None
    replaced = final.exists() or final.is_symlink()
    if replaced:
        if final.is_symlink() or not final.is_dir():
            raise BootstrapError('extension_conflict',
                                 'extension path is not a plain directory: %s' % final)
        backup = _new_backup(final.parent)
        os.rename(final, backup)
    try:
        os.rename(stage, final)
    except OSError:
        if backup is not None:
            os.rename(backup, final)
        raise
    return backup, replaced


def _restore(final, stage, backup):
    """Roll back only the extension this invocation replaced."""
    try:
        if final.exists() or final.is_symlink():
            shutil.rmtree(final, ignore_errors=True)
        if backup is not None and (backup.exists() or backup.is_symlink()):
            os.rename(backup, final)
    finally:
        if stage.exists() or stage.is_symlink():
            shutil.rmtree(stage, ignore_errors=True)


def install(bundle, expected_sha256, *, root='/', runner=None):
    """Deploy the verified bundle as a host extension and refresh systemd-sysext."""
    if not _is_root():
        raise BootstrapError('not_root', 'installing the updater runtime requires root')
    if not isinstance(expected_sha256, str) or not _HEX64.fullmatch(expected_sha256.strip().lower()):
        raise BootstrapError('hash_invalid', 'expected SHA256 must be 64 hexadecimal characters')
    expected_sha256 = expected_sha256.strip().lower()
    runner = subprocess.run if runner is None else runner

    base = Path(root)
    bundle_path = Path(bundle)
    if bundle_path.is_symlink():
        raise BootstrapError('bundle_unreadable', 'bundle path must not be a symlink')
    try:
        if not stat.S_ISREG(bundle_path.stat().st_mode):
            raise BootstrapError('bundle_unreadable', 'bundle is not a regular file')
        stream = bundle_path.open('rb')
    except OSError as error:
        raise BootstrapError('bundle_unreadable', 'cannot open bundle: %s' % error)

    with stream:
        digest = hashlib.sha256()
        size = 0
        while True:
            chunk = stream.read(_CHUNK)
            if not chunk:
                break
            size += len(chunk)
            if size > MAX_BUNDLE_BYTES:
                raise BootstrapError('bundle_too_large', 'bundle exceeds %d bytes'
                                     % MAX_BUNDLE_BYTES)
            digest.update(chunk)
        if not hmac.compare_digest(digest.hexdigest(), expected_sha256):
            raise BootstrapError('hash_mismatch',
                                 'bundle SHA256 does not match the expected digest')
        manifest, members = _scan_archive(stream)
        specs = _validate_manifest(manifest, members)

        version = manifest['version']
        runtime = _runtime_root(base)
        current = _read_updater_version(runtime)
        comparison = _version_compare(current, version)
        if comparison is not None and comparison > 0:
            raise BootstrapError('newer_runtime_present',
                                 'installed updater %s is newer than bundle %s; '
                                 'the existing runtime is left untouched'
                                 % (current, version))
        if _host_key_mismatch(base, specs):
            raise BootstrapError('trust_conflict',
                                 'the host trust anchor %s differs from the bundled key '
                                 '%s; existing trust policy is kept and nothing is installed'
                                 % (HOST_TRUST_KEY_PATH, TRUST_KEY_PATH))
        if comparison == 0:
            # The same version string is not proof of the same runtime: only
            # reuse an installation whose files still match the manifest.
            problems = _verify_runtime(runtime, specs)
            if not problems:
                return {
                    'schemaVersion': SCHEMA_VERSION,
                    'ok': True,
                    'command': COMMAND_INSTALL,
                    'state': 'reused',
                    'bundle': BUNDLE_NAME,
                    'version': current,
                    'extension': EXTENSION_NAME,
                    'path': None,
                    'replaced': False,
                    'previousVersion': current,
                    'files': len(specs),
                    'sha256': expected_sha256,
                    'verified': True,
                    'sysextRefreshed': False,
                    'entry': str(_p(base, ENTRY_PATH)),
                }

        sysext = _find(base, SYSEXT_PATHS)
        if sysext is None:
            raise BootstrapError('missing-systemd-sysext',
                                 'systemd-sysext is required to deploy the updater')
        os_release = _read_os_release(base)
        release = _extension_release(os_release)
        extensions = _p(base, RUN_EXTENSIONS)
        _mkdirs(extensions)
        if extensions.is_symlink() or not extensions.is_dir():
            raise BootstrapError('extensions_dir_unusable',
                                 '/run/extensions is not a plain directory')
        final = _extension_dir(base)
        if final.is_symlink():
            raise BootstrapError('extension_conflict',
                                 'extension path must not be a symlink: %s' % final)
        stage = _new_stage(extensions)

        try:
            _extract(stream, stage, specs)
            if _missing_runtime(stage):
                raise BootstrapError('manifest_mismatch',
                                     'staged extension is missing required runtime files')
            staged_version = _read_updater_version(stage)
            if staged_version != version:
                raise BootstrapError('manifest_mismatch',
                                     'staged updater version does not match the manifest')
            release_path = stage / EXTENSION_RELEASE
            _mkdirs(release_path.parent)
            _write_file(release_path, release, 0o644)
            _fsync_dir(release_path.parent)
            _fsync_dir(stage)
        except BaseException:
            shutil.rmtree(stage, ignore_errors=True)
            raise

        try:
            backup, replaced = _install_extension(stage, final)
        except OSError as error:
            shutil.rmtree(stage, ignore_errors=True)
            raise BootstrapError('stage_failed',
                                 'cannot activate the staged extension: %s' % error)
        except BaseException:
            shutil.rmtree(stage, ignore_errors=True)
            raise
        previous = current if replaced else None
        try:
            if not _refresh(runner, sysext):
                raise BootstrapError('sysext_failed', 'systemd-sysext refresh failed')
            if base == Path('/') and not _extension_active(base):
                raise BootstrapError('verify_failed',
                                     'systemd-sysext did not merge the updater extension')
            merged_version = _read_updater_version(final)
            if merged_version != version:
                raise BootstrapError('verify_failed',
                                     'merged updater version is %r, expected %r'
                                     % (merged_version, version))
            if _missing_runtime(final):
                raise BootstrapError('verify_failed',
                                     'merged updater runtime is incomplete')
        except BaseException:
            _restore(final, stage, backup)
            _refresh(runner, sysext)
            raise

        if backup is not None:
            shutil.rmtree(backup, ignore_errors=True)
        _fsync_dir(extensions)
        return {
            'schemaVersion': SCHEMA_VERSION,
            'ok': True,
            'command': COMMAND_INSTALL,
            'state': 'installed',
            'bundle': BUNDLE_NAME,
            'version': version,
            'extension': EXTENSION_NAME,
            'path': str(final),
            'replaced': replaced,
            'previousVersion': previous,
            'files': len(specs),
            'sha256': expected_sha256,
            'sysextRefreshed': True,
            'entry': str(_p(base, ENTRY_PATH)),
        }


# --------------------------------------------------------------------------
# command line


def _parse_install(argv):
    options = {}
    index = 0
    while index < len(argv):
        argument = argv[index]
        if '=' in argument and argument.startswith('--'):
            key, _, value = argument.partition('=')
            index += 1
        else:
            key = argument
            if index + 1 >= len(argv):
                raise BootstrapError('usage', 'missing value for %s' % key)
            value = argv[index + 1]
            index += 2
        if key not in ('--bundle', '--sha256'):
            raise BootstrapError('usage', 'unknown option: %s' % key)
        if key in options:
            raise BootstrapError('usage', 'duplicate option: %s' % key)
        options[key] = value
    if set(options) != {'--bundle', '--sha256'}:
        raise BootstrapError('usage', 'install requires --bundle and --sha256')
    return options['--bundle'], options['--sha256']


def _emit(document):
    sys.stdout.write(json.dumps(document, sort_keys=True, separators=(',', ':')) + '\n')
    sys.stdout.flush()


def main(argv=None):
    argv = list(sys.argv[1:]) if argv is None else list(argv)
    command = argv[0] if argv else None
    try:
        if command == COMMAND_PROBE:
            if len(argv) != 1:
                raise BootstrapError('usage', 'probe takes no arguments')
            result = probe()
        elif command == COMMAND_INSTALL:
            bundle, digest = _parse_install(argv[1:])
            result = install(bundle, digest)
        else:
            raise BootstrapError(
                'usage',
                'usage: armada-offline-bootstrap probe | install --bundle FILE --sha256 HEX')
    except BootstrapError as error:
        _emit({
            'schemaVersion': SCHEMA_VERSION,
            'ok': False,
            'command': command,
            'error': {'code': error.code, 'message': str(error)},
        })
        return 2 if error.code == 'usage' else 1
    except Exception as error:  # pragma: no cover - unexpected environment failure
        print('armada-offline-bootstrap: %s' % error, file=sys.stderr)
        _emit({
            'schemaVersion': SCHEMA_VERSION,
            'ok': False,
            'command': command,
            'error': {'code': 'internal', 'message': type(error).__name__},
        })
        return 1
    _emit(result)
    return 0 if result.get('ok') else 1


if __name__ == '__main__':
    raise SystemExit(main())
