#!/usr/bin/python3 -I
# SPDX-License-Identifier: GPL-2.0-or-later
"""Stage the TB710FU sensor hub files for hexagonrpcd.

The ADSP sensor hub (SSC) asks hexagonrpcd for its DSP libraries, sensor
configuration and registry. They are Lenovo's files, partly calibrated per
unit, so the image does not carry them: this helper copies them on the device,
read-only, from the running Android slot:

  dsp_<slot>:/adsp                          -> fw/dsp/adsp/
  super:vendor_<slot>:/etc/sensors/config/  -> fw/sensors/config/
  super:vendor_<slot>:/etc/sensors/sns_reg_config -> fw/sensors/sns_reg.conf
  persist:/sensors/registry/                -> registry/ (first run only)

The sensor hub writes its registry, so registry/ is a writable copy that the
hub keeps; persist itself is never written. Every partition is opened
read-only: GPT attributes come from udev, the dynamic partition table of super
is parsed here, ext4 is read with debugfs (no -w) and erofs with dump.erofs.

fw/ is extracted again when the slot or the source partitions change; a stamp
records what it was made from. Exits 0 without touching anything on every
board other than lenovo,tb710fu.
"""

import hashlib
import json
import os
import shutil
import struct
import subprocess
import sys
import tempfile

MODEL = b'lenovo,tb710fu'
DT_COMPATIBLE = os.environ.get('TB710FU_DT_COMPATIBLE',
                               '/sys/firmware/devicetree/base/compatible')
STATE_DIR = os.environ.get('TB710FU_SENSORS_STATE', '/var/lib/tb710fu-sensors')
PARTLABEL_DIR = os.environ.get('TB710FU_PARTLABEL_DIR', '/dev/disk/by-partlabel')
UDEVADM = os.environ.get('TB710FU_UDEVADM', 'udevadm')
DEBUGFS = os.environ.get('TB710FU_DEBUGFS', 'debugfs')
DUMP_EROFS = os.environ.get('TB710FU_DUMP_EROFS', 'dump.erofs')

STAMP_VERSION = 1

# Qualcomm A/B attributes in the GPT entry flags (bits 48-63).
ATTR_ACTIVE = 1 << 50
ATTR_UNBOOTABLE = 1 << 55

# Android dynamic partitions (liblp).
LP_RESERVED = 4096
LP_GEOMETRY_MAGIC = 0x616C4467
LP_GEOMETRY_SIZE = 4096
LP_HEADER_MAGIC = 0x414C5030
LP_SECTOR = 512
LP_TARGET_LINEAR = 0

EROFS_MAGIC = 0xE0F5E1E2
EROFS_SB_OFFSET = 1024
EXT4_MAGIC = 0xEF53


class PrepareError(Exception):
    pass


def log(msg):
    print('tb710fu-sensors-prepare: ' + msg, file=sys.stderr, flush=True)


def model_matches():
    try:
        with open(DT_COMPATIBLE, 'rb') as f:
            return MODEL in f.read().split(b'\0')
    except OSError:
        return False


def partition(label):
    path = os.path.join(PARTLABEL_DIR, label)
    if not os.path.exists(path):
        raise PrepareError('missing partition: ' + label)
    return path


def gpt_flags(label):
    out = subprocess.run([UDEVADM, 'info', '--query=property',
                          '--name=' + partition(label)],
                         check=True, capture_output=True, text=True).stdout
    for line in out.splitlines():
        if line.startswith('ID_PART_ENTRY_FLAGS='):
            return int(line.split('=', 1)[1], 0)
    raise PrepareError('no GPT attributes for ' + label)


def active_slot():
    active = []
    for slot in ('a', 'b'):
        flags = gpt_flags('boot_' + slot)
        if flags & ATTR_ACTIVE and not flags & ATTR_UNBOOTABLE:
            active.append(slot)
    if len(active) != 1:
        raise PrepareError('expected exactly one active Android slot, found %d'
                           % len(active))
    return active[0]


def pread_exact(f, size, offset):
    f.seek(offset)
    data = f.read(size)
    if len(data) != size:
        raise PrepareError('short read at %d' % offset)
    return data


def lp_partition_extent(super_path, name, metadata_slot):
    """Byte offset and size of a dynamic partition stored in one linear extent."""
    with open(super_path, 'rb') as f:
        size = f.seek(0, os.SEEK_END)
        geo = pread_exact(f, LP_GEOMETRY_SIZE, LP_RESERVED)
        magic, struct_size = struct.unpack_from('<II', geo, 0)
        if magic != LP_GEOMETRY_MAGIC or not 52 <= struct_size <= LP_GEOMETRY_SIZE:
            raise PrepareError('super has no dynamic partition geometry')
        checked = bytearray(geo[:struct_size])
        checked[8:40] = bytes(32)
        if hashlib.sha256(checked).digest() != geo[8:40]:
            raise PrepareError('super geometry checksum mismatch')
        max_size, slots, _ = struct.unpack_from('<III', geo, 40)
        if not 0 <= metadata_slot < slots:
            raise PrepareError('super has no metadata slot %d' % metadata_slot)
        base = LP_RESERVED + 2 * LP_GEOMETRY_SIZE + metadata_slot * max_size
        meta = pread_exact(f, max_size, base)

    magic, major, _, header_size = struct.unpack_from('<IHHI', meta, 0)
    if magic != LP_HEADER_MAGIC or major != 10 or not 128 <= header_size <= max_size:
        raise PrepareError('super metadata header invalid')
    header = bytearray(meta[:header_size])
    header[12:44] = bytes(32)
    if hashlib.sha256(header).digest() != meta[12:44]:
        raise PrepareError('super metadata header checksum mismatch')
    tables_size, = struct.unpack_from('<I', meta, 44)
    if header_size + tables_size > max_size:
        raise PrepareError('super metadata tables out of range')
    tables = meta[header_size:header_size + tables_size]
    if hashlib.sha256(tables).digest() != meta[48:80]:
        raise PrepareError('super metadata tables checksum mismatch')

    def table(index, entry_min):
        offset, count, entry = struct.unpack_from('<III', meta, 80 + 12 * index)
        if entry < entry_min or offset + count * entry > tables_size:
            raise PrepareError('super metadata table %d invalid' % index)
        return [tables[offset + i * entry:offset + (i + 1) * entry]
                for i in range(count)]

    extents = [struct.unpack_from('<QIQI', e) for e in table(1, 24)]
    for entry in table(0, 52):
        raw, _, first, count, _ = struct.unpack_from('<36sIIII', entry)
        if raw.rstrip(b'\0').decode('ascii', 'replace') != name:
            continue
        if count != 1 or first >= len(extents):
            raise PrepareError('%s is not one extent (%d)' % (name, count))
        sectors, target, sector, source = extents[first]
        if target != LP_TARGET_LINEAR or source != 0:
            raise PrepareError(name + ' is not a linear extent of super')
        offset, length = sector * LP_SECTOR, sectors * LP_SECTOR
        if offset + length > size:
            raise PrepareError(name + ' extends past super')
        return offset, length
    raise PrepareError('no dynamic partition ' + name)


def file_sha256(path):
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def vendor_identity(super_path, offset):
    with open(super_path, 'rb') as f:
        head = pread_exact(f, 4096, offset)
    erofs, = struct.unpack_from('<I', head, EROFS_SB_OFFSET)
    ext4, = struct.unpack_from('<H', head, 1080)
    if erofs != EROFS_MAGIC:
        kind = 'ext4' if ext4 == EXT4_MAGIC else 'unknown'
        raise PrepareError('vendor is not erofs (%s)' % kind)
    # The superblock carries the build time, UUID and checksum of the image.
    return hashlib.sha256(head).hexdigest()


def own_by_root(top):
    """rdump keeps the Android owners (system, uid 1000, is a Linux user here)."""
    if os.geteuid() != 0:
        return
    os.lchown(top, 0, 0)
    for parent, dirs, files in os.walk(top):
        for name in dirs + files:
            os.lchown(os.path.join(parent, name), 0, 0)


def debugfs_rdump(device, source, dest):
    # debugfs opens the file system read-only unless -w is given.
    result = subprocess.run([DEBUGFS, '-R', 'rdump %s %s' % (source, dest), device],
                            capture_output=True, text=True)
    name = os.path.join(dest, os.path.basename(source))
    if result.returncode != 0 or not os.path.isdir(name) or not os.listdir(name):
        raise PrepareError('cannot copy %s from %s: %s'
                           % (source, device, result.stderr.strip()))
    return name


def erofs(super_path, offset, *args):
    return subprocess.run([DUMP_EROFS, '--offset=%d' % offset, *args, super_path],
                          check=True, capture_output=True).stdout


def erofs_regular_files(super_path, offset, directory):
    listing = erofs(super_path, offset, '--ls', '--path=' + directory)
    names, header = [], False
    for line in listing.decode('utf-8', 'replace').splitlines():
        fields = line.split(None, 2)
        if fields[:3] == ['NID', 'TYPE', 'FILENAME']:
            header = True
        elif header and len(fields) == 3 and fields[1] == '1':
            if '/' in fields[2] or fields[2] in ('.', '..'):
                raise PrepareError('unexpected name in %s: %r' % (directory, fields[2]))
            names.append(fields[2])
    if not header or not names:
        raise PrepareError('no files in vendor ' + directory)
    return names


def erofs_copy(super_path, offset, source, dest):
    data = erofs(super_path, offset, '--cat', '--path=' + source)
    if not data:
        raise PrepareError('empty vendor file ' + source)
    with open(dest, 'wb') as f:
        f.write(data)


def fw_complete(fw):
    return (os.path.isdir(os.path.join(fw, 'dsp/adsp'))
            and os.path.isdir(os.path.join(fw, 'sensors/config'))
            and os.path.isfile(os.path.join(fw, 'sensors/sns_reg.conf')))


def read_stamp(fw):
    try:
        with open(os.path.join(fw, 'stamp.json')) as f:
            return json.load(f)
    except (OSError, ValueError):
        return None


def replace_dir(staged, target):
    old = target + '.old'
    shutil.rmtree(old, ignore_errors=True)
    if os.path.exists(target):
        os.rename(target, old)
    os.rename(staged, target)
    shutil.rmtree(old, ignore_errors=True)


def extract_fw(fw, stamp, dsp, super_path, vendor_offset):
    staged = tempfile.mkdtemp(prefix='.fw-', dir=STATE_DIR)
    try:
        os.makedirs(os.path.join(staged, 'dsp'))
        debugfs_rdump(dsp, '/adsp', os.path.join(staged, 'dsp'))
        config = os.path.join(staged, 'sensors/config')
        os.makedirs(config)
        for name in erofs_regular_files(super_path, vendor_offset,
                                        '/etc/sensors/config'):
            erofs_copy(super_path, vendor_offset,
                       '/etc/sensors/config/' + name, os.path.join(config, name))
        erofs_copy(super_path, vendor_offset, '/etc/sensors/sns_reg_config',
                   os.path.join(staged, 'sensors/sns_reg.conf'))
        with open(os.path.join(staged, 'stamp.json'), 'w') as f:
            json.dump(stamp, f, sort_keys=True)
        os.chmod(staged, 0o755)
        own_by_root(staged)
        replace_dir(staged, fw)
    except BaseException:
        shutil.rmtree(staged, ignore_errors=True)
        raise


def copy_registry(registry, persist):
    staged = tempfile.mkdtemp(prefix='.registry-', dir=STATE_DIR)
    try:
        copied = debugfs_rdump(persist, '/sensors/registry', staged)
        own_by_root(copied)
        os.rename(copied, registry)
    finally:
        shutil.rmtree(staged, ignore_errors=True)


def main():
    if not model_matches():
        log('skip: not lenovo,tb710fu')
        return 0

    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    os.chmod(STATE_DIR, 0o700)

    slot = active_slot()
    dsp = partition('dsp_' + slot)
    super_path = partition('super')
    vendor_offset, _ = lp_partition_extent(super_path, 'vendor_' + slot,
                                           0 if slot == 'a' else 1)
    stamp = {
        'version': STAMP_VERSION,
        'slot': slot,
        'dsp_sha256': file_sha256(dsp),
        'vendor_offset': vendor_offset,
        'vendor_superblock_sha256': vendor_identity(super_path, vendor_offset),
    }

    fw = os.path.join(STATE_DIR, 'fw')
    if fw_complete(fw) and read_stamp(fw) == stamp:
        log('sensor files of slot %s are current' % slot)
    else:
        extract_fw(fw, stamp, dsp, super_path, vendor_offset)
        log('sensor files extracted from slot ' + slot)

    registry = os.path.join(STATE_DIR, 'registry')
    if not os.path.isdir(registry):
        copy_registry(registry, partition('persist'))
        log('sensor registry copied from persist')
    return 0


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (PrepareError, OSError, subprocess.CalledProcessError) as exc:
        log('error: %s' % exc)
        sys.exit(1)
