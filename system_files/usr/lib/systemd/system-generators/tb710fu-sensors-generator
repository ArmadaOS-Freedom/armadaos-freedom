#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-or-later
# On lenovo,tb710fu only: iio-sensor-proxy reads the sensor hub through libssc
# (QMI over QRTR). The hub comes up seconds after the secure FastRPC node, once
# hexagonrpcd has served it, and a proxy that finds no sensor exits 0; retry
# until it finds them. The stop timeout bounds the suspend hook's stop.
compatible=${TB710FU_DT_COMPATIBLE:-/sys/firmware/devicetree/base/compatible}
tr '\0' '\n' <"$compatible" 2>/dev/null | grep -qx 'lenovo,tb710fu' || exit 0

dir=${1:?usage: tb710fu-sensors-generator NORMAL_DIR [EARLY_DIR LATE_DIR]}/iio-sensor-proxy.service.d
mkdir -p "$dir"
cat >"$dir/50-tb710fu-ssc.conf" <<'CONF'
# Generated by tb710fu-sensors-generator
[Unit]
After=tb710fu-hexagonrpcd.service
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=5
TimeoutStopSec=3
CONF
