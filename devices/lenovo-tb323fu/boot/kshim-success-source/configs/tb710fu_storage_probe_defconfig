# TB710FU development-only storage probe profile.
# Identical to tb710fu_android_defconfig plus the read-only UFS/SMMU entry
# snapshot exported to the Linux /chosen node. No storage I/O, no DMA, no
# settings; used once on hardware to measure the ABL handoff state before the
# native UFS settings backend is enabled for TB710FU.
# keys = PMK8550 pwrkey/resin (qcom,pmk8350-pon) + PM8550 GPIO6 (vol+).
# No touch (NVT SPI).
CONFIG_QCOM_KEYS=y
CONFIG_QCOM_SPMI=y
CONFIG_QCOM_KEY_DEBOUNCE_SAMPLES=2
# CONFIG_KSHIM_QEMU_PLATFORM is not set
CONFIG_KSHIM_FRAMEBUFFER=y
CONFIG_KSHIM_LVGL=y
CONFIG_KSHIM_UI_ROTATION_CCW=0
CONFIG_KSHIM_MENU_ENTRY_DURATION_MS=0
# 20 logical 3200-pixel rows.
CONFIG_KSHIM_LVGL_BUFFER_BYTES=256000
# CONFIG_KSHIM_TOUCH is not set
# CONFIG_KSHIM_SMP is not set
# CONFIG_KSHIM_UEFI_TEST_MENU is not set
# CONFIG_ENABLE_BANNER is not set
CONFIG_DEBUG_LEVEL_NONE=y
# CONFIG_KSHIM_DEBUG_CONSOLE is not set
CONFIG_ASSERT_HALT=y
CONFIG_KSHIM_MENU_STYLE_STAR_CHART=y
CONFIG_KSHIM_MENU_LANGUAGE_SWITCH=y
# Session settings off: legacy default handling (initial row always auto-boots).
# CONFIG_KSHIM_MENU_SESSION_SETTINGS is not set
CONFIG_KSHIM_MENU_CHINESE=y
CONFIG_KSHIM_MENU_ENTRY_DETAILS=y
CONFIG_KSHIM_MENU_BASE_ANDROID=y
CONFIG_KSHIM_MENU_POWER_ACTIONS=y
CONFIG_KSHIM_MENU_ADVANCED_ACTIONS=y
CONFIG_KSHIM_QCOM_REBOOT=y
# CONFIG_KSHIM_BOOT_TIMING is not set

# Development-only read-only UFS/SMMU entry snapshot.
CONFIG_KSHIM_STORAGE_ENTRY_PROBE=y
